                    I know this is just a little corner of the internet,
                    but I wanted to make something that feels a little
                    more special — just for you.
                </p>

                <p>
                    You deserve all the happiness, beautiful moments,
                    genuine smiles and little reasons to be happy
                    today and every day. 🌸
                </p>

                <p>
                    May this new year of your life bring you closer
                    to everything your heart wishes for.
                    Keep smiling, keep shining, and always stay
                    the wonderful person you are. 🦋
                </p>


                <div class="modal-divider">
                    <span></span>
                    <i>♥</i>
                    <span></span>
                </div>


                <p class="birthday-final-message">
                    Some people are special without even trying.
                    <br />
                    You are one of those people. ❤️
                    <br /><br />
                    <strong>
                        Happy Birthday once again, Chulbul! 🎈✨
                    </strong>
                </p>


                <button class="modal-button"
                        type="button"
                        @onclick="CloseChulbul">

                    <span>Keep smiling ❤️</span>
                    <span>→</span>

                </button>

            </div>

        </div>
    }
</div>


@code {

    private string name = string.Empty;
    private string? error;
    private bool creating;
    private bool showChulbul;
    private bool darkMode = true;


    private void OpenChulbul()
    {
        showChulbul = true;
    }


    private void CloseChulbul()
    {
        showChulbul = false;
    }


    private void ToggleTheme()
    {
        darkMode = !darkMode;
    }


    private async Task CreateRoom()
    {
        error = null;

        var displayName = name.Trim();

        if (string.IsNullOrWhiteSpace(displayName))
        {
            error = "Please enter your display name.";
            return;
        }

        if (displayName.Length < 2)
        {
            error = "Your display name must contain at least 2 characters.";
            return;
        }

        if (displayName.Length > 40)
        {
            error = "Your display name cannot be longer than 40 characters.";
            return;
        }

        creating = true;

        try
        {
            var roomCode = await ChatService.CreateRoomAsync();

            Navigation.NavigateTo(
                $"/chat/{roomCode}?name={Uri.EscapeDataString(displayName)}");
        }
        catch (Exception ex)
        {
            error = $"Unable to create the room: {ex.Message}";
        }
        finally
        {
            creating = false;
        }
    }


    private async Task HandleNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !creating)
        {
            await CreateRoom();
        }
    }

}
