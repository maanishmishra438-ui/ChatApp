    // ============================================================
    // DELETE
    // ============================================================

    private void AskDeleteForMe(
        MessageVm message)
    {
        selectedMessage = message;

        deleteMode =
            DeleteMode.DeleteForMe;

        showDeleteModal = true;

        openMenuMessageId = null;
        reactionPickerMessageId = null;
    }


    private void AskUnsend(
        MessageVm message)
    {
        if (!IsMine(message) ||
            message.IsDeleted)
        {
            return;
        }

        selectedMessage = message;

        deleteMode =
            DeleteMode.Unsend;

        showDeleteModal = true;

        openMenuMessageId = null;
        reactionPickerMessageId = null;
    }


    private void CloseDeleteModal()
    {
        if (isDeleting)
        {
            return;
        }

        showDeleteModal = false;

        selectedMessage = null;

        deleteMode =
            DeleteMode.DeleteForMe;
    }


    private async Task ConfirmDelete()
    {
        if (selectedMessage is null ||
            hub is null ||
            !connected)
        {
            return;
        }

        isDeleting = true;

        var messageId =
            selectedMessage.Id;

        try
        {
            if (deleteMode ==
                DeleteMode.DeleteForMe)
            {
                await hub.InvokeAsync(
                    "DeleteMessageForMe",
                    RoomCode,
                    messageId,
                    name);

                showDeleteModal = false;

                selectedMessage = null;
            }
            else
            {
                await hub.InvokeAsync(
                    "UnsendMessage",
                    RoomCode,
                    messageId,
                    name);

                showDeleteModal = false;

                selectedMessage = null;
            }

            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            error =
                $"Unable to delete message: {ex.Message}";

            showDeleteModal = false;

            selectedMessage = null;

            await InvokeAsync(
                StateHasChanged);
        }
        finally
        {
            isDeleting = false;
        }
    }


    private string GetDeletePreview(
        string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        var cleanText =
            text
                .Replace("\r", " ")
                .Replace("\n", " ")
                .Trim();

        if (cleanText.Length <= 100)
        {
            return cleanText;
        }

        return cleanText[..100] + "…";
    }


    // ============================================================
    // KEYBOARD / TYPING
    // ============================================================

    private async Task HandleKeyDown(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter" &&
            !e.ShiftKey)
        {
            await Send();

            return;
        }

        if (hub is null ||
            !connected)
        {
            return;
        }

        try
        {
            await hub.InvokeAsync(
                "UserTyping",
                RoomCode,
                name,
                true);
        }
        catch
        {
        }

        typingCts?.Cancel();
        typingCts?.Dispose();

        typingCts =
            new CancellationTokenSource();

        _ =
            StopTypingLaterAsync(
                typingCts.Token);
    }


    private async Task StopTypingLaterAsync(
        CancellationToken token)
    {
        try
        {
            await Task.Delay(
                900,
                token);

            if (token.IsCancellationRequested ||
                hub is null ||
                !connected)
            {
                return;
            }

            try
            {
                await hub.InvokeAsync(
                    "UserTyping",
                    RoomCode,
                    name,
                    false);
            }
            catch
            {
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
    }


    // ============================================================
    // SEND
    // ============================================================

    private async Task Send()
    {
        if (hub is null ||
            !connected)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(draft))
        {
            return;
        }

        var text =
            draft.Trim();

        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        if (text.Length > 2000)
        {
            text =
                text[..2000];
        }

        var replyId =
            replyingTo?.Id;

        draft = string.Empty;

        try
        {
            await hub.InvokeAsync(
                "SendMessage",
                RoomCode,
                name,
                text,
                replyId);

            typingUser = null;

            typingCts?.Cancel();

            replyingTo = null;

            await InvokeAsync(
                StateHasChanged);

            await ScrollToBottomAsync();
        }
        catch (Exception ex)
        {
            draft = text;

            error =
                $"Unable to send message: {ex.Message}";

            await InvokeAsync(
                StateHasChanged);
        }
    }


    // ============================================================
    // COPY INVITE
    // ============================================================

    private async Task CopyInvite()
    {
        try
        {
            try
            {
                var browserOrigin =
                    await JS.InvokeAsync<string>(
                        "eval",
                        "window.location.origin");

                if (!string.IsNullOrWhiteSpace(
                        browserOrigin))
                {
                    publicOrigin =
                        browserOrigin.TrimEnd('/');
                }
            }
            catch
            {
            }

            var inviteUrl =
                InviteUrl;

            await JS.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                inviteUrl);

            toastMessage =
                "Invite link copied";

            showToast = true;

            await InvokeAsync(
                StateHasChanged);

            await Task.Delay(1500);

            showToast = false;

            await InvokeAsync(
                StateHasChanged);
        }
        catch
        {
        }
    }


    // ============================================================
    // LEAVE
    // ============================================================

    private void OpenLeaveModal()
    {
        if (!isLeaving)
        {
            showLeaveModal = true;
        }
    }


    private void CloseLeaveModal()
    {
        if (!isLeaving)
        {
            showLeaveModal = false;
        }
    }


    private async Task LeaveRoom()
    {
        if (isLeaving)
        {
            return;
        }

        isLeaving = true;

        try
        {
            typingCts?.Cancel();

            seenTimerCts?.Cancel();

            // Stop heartbeat before leaving.
            presenceHeartbeatCts?.Cancel();

            if (hub is not null)
            {
                try
                {
                    await hub.DisposeAsync();
                }
                catch
                {
                }

                hub = null;
            }

            connected = false;

            if (!string.IsNullOrWhiteSpace(name))
            {
                onlineUsers.Remove(name);
            }

            Navigation.NavigateTo(
                "/",
                forceLoad: true);
        }
        catch
        {
            isLeaving = false;

            showLeaveModal = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }


    // ============================================================
    // IS MINE
    // ============================================================

    private bool IsMine(
        MessageVm message)
    {
        return
            message.Sender.Equals(
                name,
                StringComparison.OrdinalIgnoreCase);
    }


    // ============================================================
    // SEEN TIMER
    // ============================================================

    private void StartSeenTimer()
    {
        if (seenTimer is not null)
        {
            return;
        }

        seenTimerCts =
            new CancellationTokenSource();

        seenTimer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(15));

        _ =
            RunSeenTimerAsync(
                seenTimerCts.Token);
    }


    private async Task RunSeenTimerAsync(
        CancellationToken token)
    {
        try
        {
            while (
                seenTimer is not null &&
                await seenTimer.WaitForNextTickAsync(
                    token))
            {
                if (seenTimes.Count > 0)
                {
                    await InvokeAsync(
                        StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
    }


    // ============================================================
    // SEEN TITLE
    // ============================================================

    private string GetSeenTitle(
        MessageVm message)
    {
        if (!message.IsRead)
        {
            return message.IsDelivered
                ? "Delivered to recipient"
                : "Message sent";
        }

        if (!seenTimes.TryGetValue(
                message.Id,
                out var seenAt))
        {
            return "Seen";
        }

        return
            $"Seen at {seenAt.ToLocalTime():dd MMM yyyy HH:mm}";
    }


    // ============================================================
    // AFTER RENDER
    // ============================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender)
        {
            dotNetReference =
                DotNetObjectReference.Create(
                    this);

            try
            {
                await JS.InvokeVoidAsync(
                    "chatApp.initialize");
            }
            catch
            {
            }

            // Load push notification JavaScript module.
            try
            {
                pushModule =
                    await JS.InvokeAsync<IJSObjectReference>(
                        "import",
                        "/js/pushNotifications.js");
            }
            catch
            {
                pushModule = null;
            }

            // Get actual browser origin.
            try
            {
                var browserOrigin =
                    await JS.InvokeAsync<string>(
                        "eval",
                        "window.location.origin");

                if (!string.IsNullOrWhiteSpace(
                        browserOrigin))
                {
                    var normalized =
                        browserOrigin.TrimEnd('/');

                    if (!string.Equals(
                            publicOrigin,
                            normalized,
                            StringComparison.OrdinalIgnoreCase))
                    {
                        publicOrigin =
                            normalized;

                        await InvokeAsync(
                            StateHasChanged);
                    }
                }
            }
            catch
            {
            }
        }

        if (hasJoined &&
            connected &&
            dotNetReference is not null)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "chatApp.observeMessages",
                    dotNetReference);
            }
            catch
            {
            }
        }
    }


    // ============================================================
    // SCROLL
    // ============================================================

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "chatApp.scrollToBottom");
        }
        catch
        {
        }
    }


    // ============================================================
    // DISPOSE
    // ============================================================

    public async ValueTask DisposeAsync()
    {
        // --------------------------------------------------------
        // STOP TYPING TIMER
        // --------------------------------------------------------

        try
        {
            typingCts?.Cancel();
            typingCts?.Dispose();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // STOP PRESENCE HEARTBEAT
        // --------------------------------------------------------

        try
        {
            presenceHeartbeatCts?.Cancel();
            presenceHeartbeatCts?.Dispose();
        }
        catch
        {
        }

        try
        {
            presenceHeartbeatTimer?.Dispose();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // STOP SEEN TIMER
        // --------------------------------------------------------

        try
        {
            seenTimerCts?.Cancel();
            seenTimerCts?.Dispose();
        }
        catch
        {
        }

        try
        {
            seenTimer?.Dispose();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // STOP OFFLINE REMOVAL TIMERS
        // --------------------------------------------------------

        try
        {
            foreach (
                var cts
                in offlineRemovalTimers.Values.ToList())
            {
                try
                {
                    cts.Cancel();
                    cts.Dispose();
                }
                catch
                {
                }
            }

            offlineRemovalTimers.Clear();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // DISPOSE DOTNET REFERENCE
        // --------------------------------------------------------

        try
        {
            dotNetReference?.Dispose();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // DISPOSE PUSH MODULE
        // --------------------------------------------------------

        try
        {
            if (pushModule is not null)
            {
                await pushModule.DisposeAsync();
            }
        }
        catch
        {
        }


        // --------------------------------------------------------
        // DISPOSE SIGNALR
        // --------------------------------------------------------

        try
        {
            if (hub is not null)
            {
                await hub.DisposeAsync();
            }
        }
        catch
        {
        }
    }


