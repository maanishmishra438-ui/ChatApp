@page "/chat/{RoomCode}"

@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using ChatApp.Web.Data

@inject NavigationManager Navigation
@inject ChatApp.Web.Services.ChatService ChatService
@inject IJSRuntime JS

@implements IAsyncDisposable

<PageTitle>Private Chat</PageTitle>

@if (!isInitializing && !hasJoined)
{
    <div class="join-screen">

        <div class="join-card">

            <div class="join-brand">
                <div class="join-brand-icon">
                    🔒
                </div>

                <div class="join-brand-name">
                    Chat<span>App</span>
                </div>
            </div>

            <div class="room-badge">
                <span class="room-badge-dot"></span>
                PRIVATE ROOM
            </div>

            <div class="join-hero-icon">
                <div class="join-hero-icon-inner">
                    🔐
                </div>
            </div>

            <h1>
                Join Private Chat
            </h1>

            <p class="join-description">
                Enter your display name to join this private conversation.
            </p>

            <div class="join-form">

                <label for="displayName">
                    Display name
                </label>

                <div class="name-input-wrapper">

                    <span class="name-input-icon">
                        👤
                    </span>

                    <input id="displayName"
                           @bind="joinName"
                           @bind:event="oninput"
                           maxlength="40"
                           autocomplete="off"
                           placeholder="e.g. Manish"
                           @onkeydown="HandleJoinKeyDown" />

                    @if (!string.IsNullOrWhiteSpace(joinName))
                    {
                        <span class="input-check">
                            ✓
                        </span>
                    }

                </div>

                @if (!string.IsNullOrWhiteSpace(joinError))
                {
                    <div class="join-error">
                        <span>!</span>
                        @joinError
                    </div>
                }

                <button class="join-button"
                        @onclick="JoinChat"
                        disabled="@(isJoining || string.IsNullOrWhiteSpace(joinName))">

                    @if (isJoining)
                    {
                        <span class="join-spinner"></span>

                        <span>
                            Joining...
                        </span>
                    }
                    else
                    {
                        <span>
                            Join Chat
                        </span>

                        <span class="join-arrow">
                            →
                        </span>
                    }

                </button>

            </div>

            <div class="join-privacy">

                <div class="privacy-icon">
                    🔒
                </div>

                <div class="privacy-content">

                    <strong>
                        Private conversation
                    </strong>

                    <span>
                        Anyone with the room link can enter this conversation.
                    </span>

                </div>

            </div>

            <div class="join-footer">
                <span>Real-time messaging</span>
                <span class="footer-separator">•</span>
                <span>Private room</span>
                <span class="footer-separator">•</span>
                <span>Messages saved</span>
            </div>

        </div>

    </div>
}
else
{
    <div class="chat-shell">

        <!-- ============================================================
             TOP BAR
             ============================================================ -->

        <header class="topbar">

            <a class="logo"
               href="/">
                Chat<span>App</span>
            </a>

            <div class="top-actions">

                <div class="user-chip">

                    <span class="user-chip-avatar">
                        @Initial
                    </span>

                    <span class="user-chip-name">
                        @name
                    </span>

                </div>

                <span class="connection">

                    <i class="@(connected ? "online" : "offline")"></i>

                    @(connected ? "Connected" : "Connecting…")

                </span>

                <!-- =====================================================
                     NOTIFICATIONS
                     ===================================================== -->

                <button type="button"
                        class="share-button notification-button"
                        @onclick="EnableNotifications"
                        disabled="@notificationBusy">

                    <span class="share-icon">
                        🔔
                    </span>

                    @if (notificationBusy)
                    {
                        <span>Enabling...</span>
                    }
                    else if (notificationsEnabled)
                    {
                        <span>Notifications on</span>
                    }
                    else
                    {
                        <span>Enable notifications</span>
                    }

                </button>

                <button class="share-button"
                        @onclick="CopyInvite">

                    <span class="share-icon">
                        ↗
                    </span>

                    Copy invite link

                </button>

                <button class="leave-button"
                        @onclick="OpenLeaveModal"
                        disabled="@isLeaving">

                    <span class="leave-icon">
                        ↪
                    </span>

                    Leave room

                </button>

            </div>

        </header>


        <!-- ============================================================
             MAIN LAYOUT
             ============================================================ -->

        <main class="chat-layout">

            <!-- ========================================================
                 SIDEBAR
                 ======================================================== -->

            <aside class="side-panel">

                <div class="avatar">
                    @Initial
                </div>

                <h2>
                    Private chat
                </h2>

                <p>
                    Send this invite link to the person you want to chat with.
                </p>

                <div class="invite">

                    <small>
                        INVITE LINK
                    </small>

                    <div class="invite-url">
                        @InviteUrl
                    </div>

                    <button @onclick="CopyInvite">
                        Copy link
                    </button>

                </div>

                <div class="warning">
                    Keep the link private.
                    Anyone with the link can enter this room.
                </div>


                <!-- ====================================================
                     ROOM MEMBERS
                     ==================================================== -->

                <div class="presence-card">

                    <div class="presence-card-header">

                        <span class="presence-card-title">
                            ROOM MEMBERS
                        </span>

                        <span class="presence-card-count">
                            @knownParticipants.Count
                        </span>

                    </div>

                    <div class="presence-member-list">

                        @foreach (var participant in ParticipantNames)
                        {
                            var participantOnline =
                            IsUserOnline(participant);

                            <div class="presence-member">

                                <div class="presence-member-avatar">
                                    @(participant.Trim()[0].ToString().ToUpperInvariant())
                                </div>

                                <div class="presence-member-info">

                                    <span class="presence-member-name">

                                        @participant

                                        @if (participant.Equals(
                                                                        name,
                                                                        StringComparison.OrdinalIgnoreCase))
                                        {
                                            <small>
                                                You
                                            </small>
                                        }

                                </span>

                                <span class="presence-member-status @(participantOnline ? "online" : "offline")">

                                    <i></i>

                                    @(participantOnline
                                                                    ? "Online"
                                                                    : "Offline")

                            </span>

                                </div>

                            </div>
                                        }

                    </div>

                </div>


                <button class="side-leave-button"
                        @onclick="OpenLeaveModal"
                        disabled="@isLeaving">

                    <span>
                        ↪
                    </span>

                    Leave this room

                </button>

            </aside>


            <!-- ========================================================
                 CONVERSATION
                 ======================================================== -->

            <section class="conversation">

                <div class="conversation-header">

                    <div>

                        <div class="conversation-title-row">

                            <h3>
                                Private Room
                            </h3>

                            <span class="room-private-pill">
                                Private
                            </span>

                        </div>

                        <span class="room-code-label">
                            Room @RoomCode
                        </span>

                    </div>

                    <div class="room-status presence-summary">

                        <span class="status-dot"></span>

                        @if (onlineUsers.Count == 0)
                        {
                            <span>
                                Offline
                            </span>
                        }
                        else if (onlineUsers.Count == 1)
                        {
                            <span>
                                1 person online
                            </span>
                        }
                        else
                        {
                            <span>
                                @onlineUsers.Count people online
                            </span>
                        }

                    </div>

                    <button type="button"
                            class="mobile-info-button"
                            @onclick="OpenMobileInfo"
                            aria-label="Open room information"
                            title="Room info">

                        <span>ⓘ</span>

                    </button>

                </div>


                <!-- =====================================================
                     MESSAGES
                     ===================================================== -->

                <div class="messages"
                     @ref="messagesContainer"
                     @onclick="CloseFloatingActions">

                    @if (messages.Count == 0)
                    {
                        <div class="empty">

                            <div class="spark">
                                ✦
                            </div>

                            <h4>
                                No messages yet
                            </h4>

                            <p>
                                Send the first message.
                            </p>

                        </div>
                    }
                    else
                    {
                        @foreach (var message in messages)
                        {
                            var mine = IsMine(message);

                            <div class="message-row @(mine ? "mine" : "theirs")"
                                 data-message-id="@message.Id"
                                 data-is-read="@message.IsRead.ToString().ToLowerInvariant()"
                                 @onclick:stopPropagation="true">

                                <!-- REACTION PICKER -->
                                @if (reactionPickerMessageId == message.Id &&
                                                    !message.IsDeleted)
                                {
                                    <div class="reaction-picker"
                                         @onclick:stopPropagation="true">

                                        @foreach (var reaction in ReactionOptions)
                                        {
                                            <button type="button"
                                                    class="reaction-picker-button @(HasUserReaction(message, reaction) ? "selected" : "")"
                                                    @onclick="() => ReactToMessage(message, reaction)"
                                                    title="React with @reaction">

                                                @reaction

                                            </button>
                                        }

                                    </div>
                                }


                                <!-- MESSAGE BUBBLE -->

                                <div class="bubble">

                                    @if (message.IsDeleted)
                                    {
                                        <div class="deleted-message">

                                            <span class="deleted-message-icon">
                                                ◌
                                            </span>

                                            <span class="deleted-message-text">
                                                This message was deleted
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        @if (message.ReplyToMessageId.HasValue &&
                                                                !string.IsNullOrWhiteSpace(message.ReplyToText))
                                        {
                                            <div class="quoted-message">

                                                <div class="quoted-message-line"></div>

                                                <div class="quoted-message-content">

                                                    <span class="quoted-message-sender">
                                                        @message.ReplyToSender
                                                    </span>

                                                    <span class="quoted-message-text">
                                                        @(GetReplyPreview(message.ReplyToText))
                                                    </span>

                                                </div>

                                            </div>
                                        }

                                        @if (!mine)
                                        {
                                            <strong>
                                                @message.Sender
                                            </strong>
                                        }

                                        <div class="message-text">
                                            @message.Text
                                        </div>
                                    }


                                    <!-- REACTIONS -->
                                    @if (!message.IsDeleted &&
                                                            message.ReactionItems.Count > 0)
                                    {
                                        <div class="message-reactions">

                                            @foreach (var group in GetReactionGroups(message))
                                            {
                                                <button type="button"
                                                        class="reaction-chip @(group.IsMine ? "mine" : "")"
                                                        @onclick="() => ReactToMessage(message, group.Reaction)"
                                                        title="@group.UsersText">

                                                    <span class="reaction-emoji">
                                                        @group.Reaction
                                                    </span>

                                                    <span class="reaction-count">
                                                        @group.Count
                                                    </span>

                                                </button>
                                            }

                                        </div>
                                    }


                                <!-- FOOTER -->

                                <div class="message-footer">

                                    <time>
                                        @(message.SentAt
                                                                        .ToLocalTime()
                                                                        .ToString("HH:mm"))
                            </time>

                            @if (mine)
                                        {
                                            @if (message.IsDeleted)
                                            {
                                                <span class="message-read deleted-status">
                                                    Deleted
                                                </span>
                                            }
                                            else if (message.IsRead)
                                            {
                                                <span class="message-read seen"
                                                      title="@GetSeenTitle(message)">
                                                    ✓✓ Seen
                                                </span>
                                            }
                                            else if (message.IsDelivered)
                                            {
                                                <span class="message-read seen"
                                                      title="Delivered to recipient">
                                                    ✓✓ Delivered
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="message-read sent"
                                                      title="Message sent">
                                                    ✓ Sent
                                                </span>
                                            }
                                        }

                                    </div>

                                </div>


                                <!-- MESSAGE ACTIONS -->
                                @if (!message.IsDeleted)
                                {
                                    <div class="message-hover-actions"
                                         @onclick:stopPropagation="true">

                                        <button type="button"
                                                class="message-tool-button reaction-trigger"
                                                @onclick="() => ToggleReactionPicker(message.Id)"
                                                title="React to this message">

                                            <span class="message-tool-icon">
                                                😊
                                            </span>

                                            <span class="message-tool-label">
                                                React
                                            </span>

                                        </button>


                                        <button type="button"
                                                class="reply-message-button"
                                                @onclick="() => StartReply(message)"
                                                title="Reply to this message">

                                            <span class="reply-message-icon">
                                                ↩
                                            </span>

                                            <span>
                                                Reply
                                            </span>

                                        </button>


                                        <div class="message-menu-wrap">

                                            <button type="button"
                                                    class="message-menu-button"
                                                    @onclick="() => ToggleMessageMenu(message.Id)"
                                                    title="Message options">

                                                ⋯

                                            </button>

                                            @if (openMenuMessageId == message.Id)
                                            {
                                                <div class="message-action-menu"
                                                     @onclick:stopPropagation="true">

                                                    <button type="button"
                                                            class="message-action-item"
                                                            @onclick="() => AskDeleteForMe(message)">

                                                        <span class="message-action-icon">
                                                            ◯
                                                        </span>

                                                        <span>
                                                            Delete for me
                                                        </span>

                                                    </button>

                                                    @if (mine)
                                                    {
                                                        <button type="button"
                                                                class="message-action-item danger"
                                                                @onclick="() => AskUnsend(message)">

                                                            <span class="message-action-icon">
                                                                ↶
                                                            </span>

                                                            <span>
                                                                Unsend
                                                            </span>

                                                        </button>
                                                    }

                                                </div>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                    }

                </div>


                <!-- TYPING -->
                @if (!string.IsNullOrWhiteSpace(typingUser))
                {
                    <div class="typing">

                        <span>
                            @typingUser is typing
                        </span>

                        <span class="typing-dots">
                            <i></i>
                            <i></i>
                            <i></i>
                        </span>

                    </div>
                }


                <!-- REPLY PREVIEW -->
                @if (replyingTo is not null)
                {
                    <div class="reply-preview">

                        <div class="reply-preview-accent"></div>

                        <div class="reply-preview-icon">
                            ↩
                        </div>

                        <div class="reply-preview-content">

                            <span class="reply-preview-label">
                                Replying to @replyingTo.Sender
                            </span>

                            <span class="reply-preview-text">
                                @(GetReplyPreview(replyingTo.Text))
                            </span>

                        </div>

                        <button type="button"
                                class="reply-preview-close"
                                @onclick="CancelReply"
                                title="Cancel reply">

                            ×

                        </button>

                    </div>
                }


                <!-- COMPOSER -->

                <footer class="composer">

                    <textarea @ref="messageInput"
                              @bind="draft"
                              @bind:event="oninput"
                              @onkeydown="HandleKeyDown"
                              placeholder="Type a message..."
                              rows="1"
                              maxlength="2000"
                              autocomplete="off"></textarea>

                    <button class="send"
                            @onclick="Send"
                            disabled="@(!connected || string.IsNullOrWhiteSpace(draft))"
                            title="Send message">

                        →

                    </button>

                </footer>


                <!-- MOBILE INFO -->
                @if (mobileInfoOpen)
                {
                    <div class="mobile-info-backdrop"
                         @onclick="CloseMobileInfo">

                        <aside class="mobile-info-drawer"
                               @onclick:stopPropagation="true">

                            <div class="mobile-info-drawer-header">

                                <div>

                                    <span class="mobile-info-eyebrow">
                                        ROOM INFORMATION
                                    </span>

                                    <h3>
                                        Private chat
                                    </h3>

                                </div>

                                <button type="button"
                                        class="mobile-info-close"
                                        @onclick="CloseMobileInfo"
                                        aria-label="Close room information">

                                    ×

                                </button>

                            </div>


                            <div class="mobile-info-profile">

                                <div class="mobile-info-avatar">
                                    @Initial
                                </div>

                                <div class="mobile-info-profile-text">

                                    <strong>
                                        @name
                                    </strong>

                                    <span>
                                        Current participant
                                    </span>

                                </div>

                            </div>


                            <div class="mobile-info-section">

                                <span class="mobile-info-section-title">
                                    ROOM CODE
                                </span>

                                <div class="mobile-info-room-code">

                                    <span>
                                        @RoomCode
                                    </span>

                                    <button type="button"
                                            @onclick="CopyInvite"
                                            aria-label="Copy invite link">

                                        Copy

                                    </button>

                                </div>

                            </div>


                            <div class="mobile-info-section">

                                <span class="mobile-info-section-title">
                                    CONNECTION
                                </span>

                                <div class="mobile-info-status-row">

                                    <span class="status-dot @(connected ? "online" : "offline")"></span>

                                    <span>
                                        @(connected
                                                                        ? "Connected"
                                                                        : "Connecting…")
                            </span>

                                </div>

                            </div>


                            <div class="mobile-info-section">

                                <div class="mobile-info-members-heading">

                                    <span class="mobile-info-section-title">
                                        ROOM MEMBERS
                                    </span>

                                    <span class="mobile-info-member-count">
                                        @knownParticipants.Count
                                    </span>

                                </div>


                                <div class="mobile-info-members">

                            @foreach (var participant in ParticipantNames)
                                    {
                                        var participantOnline =
                                        IsUserOnline(participant);

                                        <div class="mobile-info-member">

                                            <div class="mobile-info-member-avatar">
                                                @(participant.Trim()[0].ToString().ToUpperInvariant())
                                            </div>

                                            <div class="mobile-info-member-copy">

                                                <span class="mobile-info-member-name">

                                                    @participant

                                                    @if (participant.Equals(
                                                                                            name,
                                                                                            StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <small>
                                                            You
                                                        </small>
                                                    }

                                    </span>

                                    <span class="mobile-info-member-status @(participantOnline ? "online" : "offline")">

                                        <i></i>

                                        @(participantOnline
                                                                                ? "Online"
                                                                                : "Offline")

                                    </span>

                                            </div>

                                        </div>
                                                        }

                                </div>

                            </div>


                            <div class="mobile-info-private-note">

                                <span>
                                    🔒
                                </span>

                                <div>

                                    <strong>
                                        Private conversation
                                    </strong>

                                    <p>
                                        Anyone with this room link can enter the conversation.
                                    </p>

                                </div>

                            </div>


                            <button type="button"
                                    class="mobile-info-leave"
                                    @onclick="OpenLeaveModal"
                                    disabled="@isLeaving">

                                <span>
                                    ↪
                                </span>

                                Leave this room

                            </button>

                        </aside>

                    </div>
                }

            </section>

        </main>

    </div>


    <!-- TOAST -->
    @if (showToast)
    {
        <div class="toast">
            @toastMessage
        </div>
    }


    <!-- NOTIFICATION ERROR -->
    @if (!string.IsNullOrWhiteSpace(notificationError))
    {
        <div class="toast notification-error-toast">
            @notificationError
        </div>
    }


    <!-- LEAVE MODAL -->
    @if (showLeaveModal)
    {
        <div class="leave-modal-backdrop"
             @onclick="CloseLeaveModal">

            <div class="leave-modal"
                 @onclick:stopPropagation="true">

                <div class="leave-modal-icon">
                    ↪
                </div>

                <div class="leave-modal-content">

                    <h3>
                        Leave this room?
                    </h3>

                    <p>
                        You'll disconnect from this conversation.
                        You can join again later using the same room link.
                    </p>

                </div>

                <div class="leave-modal-actions">

                    <button class="stay-button"
                            @onclick="CloseLeaveModal"
                            disabled="@isLeaving">

                        Stay here

                    </button>

                    <button class="confirm-leave-button"
                            @onclick="LeaveRoom"
                            disabled="@isLeaving">

                        @if (isLeaving)
                        {
                            <span class="leave-spinner"></span>

                            <span>
                                Leaving...
                            </span>
                        }
                        else
                        {
                            <span>
                                Leave room
                            </span>

                            <span>
                                →
                            </span>
                        }

                    </button>

                </div>

            </div>

        </div>
    }


    <!-- DELETE MODAL -->
    @if (showDeleteModal &&
             selectedMessage is not null)
    {
        <div class="delete-modal-backdrop"
             @onclick="CloseDeleteModal">

            <div class="delete-modal"
                 @onclick:stopPropagation="true">

                <div class="delete-modal-icon">

                    @if (deleteMode == DeleteMode.Unsend)
                    {
                        <span>
                            ↶
                        </span>
                    }
                    else
                    {
                        <span>
                            ◯
                        </span>
                    }

                </div>

                <div class="delete-modal-content">

                    @if (deleteMode == DeleteMode.Unsend)
                    {
                        <h3>
                            Unsend this message?
                        </h3>

                        <p>
                            This message will be deleted for everyone in this room.
                        </p>
                    }
                    else
                    {
                        <h3>
                            Delete for you?
                        </h3>

                        <p>
                            This message will be removed from your chat history only.
                        </p>
                    }

                    <div class="delete-modal-preview">
                        "@(GetDeletePreview(selectedMessage.Text))"
                    </div>

                </div>

                <div class="delete-modal-actions">

                    <button class="delete-cancel-button"
                            @onclick="CloseDeleteModal"
                            disabled="@isDeleting">

                        Cancel

                    </button>

                    <button class="delete-confirm-button @(deleteMode == DeleteMode.Unsend ? "danger" : "")"
                            @onclick="ConfirmDelete"
                            disabled="@isDeleting">

                        @if (isDeleting)
                        {
                            <span class="delete-spinner"></span>

                            <span>
                                Working...
                            </span>
                        }
                        else if (deleteMode == DeleteMode.Unsend)
                        {
                            <span>
                                Unsend
                            </span>
                        }
                        else
                        {
                            <span>
                                Delete
                            </span>
                        }

                    </button>

                </div>

            </div>

        </div>
    }
}


@code {

    // ============================================================
    // PARAMETERS
    // ============================================================

    [Parameter]
    public string RoomCode { get; set; } = string.Empty;


    // ============================================================
    // QUERY STRING
    // ============================================================

    private string QueryName { get; set; } = string.Empty;


    // ============================================================
    // SIGNALR
    // ============================================================

    private HubConnection? hub;

    private bool connected;


    // ============================================================
    // JS
    // ============================================================

    private DotNetObjectReference<Chat>?
        dotNetReference;

    private IJSObjectReference? pushModule;


    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    private bool notificationsEnabled;

    private bool notificationBusy;

    private string? notificationError;


    // ============================================================
    // ELEMENT REFERENCES
    // ============================================================

    private ElementReference messagesContainer;

    private ElementReference messageInput;


    // ============================================================
    // MESSAGE DATA
    // ============================================================

    private readonly List<MessageVm> messages = new();

    private readonly Dictionary<long, DateTime> seenTimes = new();


    // ============================================================
    // PRESENCE
    // ============================================================

    private readonly HashSet<string> onlineUsers =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly HashSet<string> knownParticipants =
        new(StringComparer.OrdinalIgnoreCase);


    // ============================================================
    // OFFLINE PARTICIPANT CLEANUP
    // ============================================================

    private static readonly TimeSpan OfflineRemovalDelay =
        TimeSpan.FromMinutes(2);

    private readonly Dictionary<string, CancellationTokenSource>
        offlineRemovalTimers =
            new(StringComparer.OrdinalIgnoreCase);


    // ============================================================
    // PRESENCE HEARTBEAT
    // ============================================================

    private CancellationTokenSource? presenceHeartbeatCts;

    private PeriodicTimer? presenceHeartbeatTimer;


    // ============================================================
    // REPLY STATE
