    // ============================================================

    private enum DeleteMode
    {
        DeleteForMe,
        Unsend
    }


    // ============================================================
    // VIEW MODELS
    // ============================================================

    private sealed record MessageVm(
        long Id,
        string Sender,
        string Text,
        DateTime SentAt,
        bool IsRead,
        long? ReplyToMessageId,
        string? ReplyToSender,
        string? ReplyToText,
        bool IsDeleted = false,
        List<ReactionVm>? Reactions = null)
    {
        /*
         * IMPORTANT:
         * Reactions can come back null from SignalR/database history.
         * This property guarantees a non-null enumerable.
         *
         * This is the fix for CS8604 warnings caused by
         * Any() and GroupBy() on message.Reactions.
         */
        public IReadOnlyList<ReactionVm> ReactionItems =>
            Reactions ?? [];
    }


    public sealed record ReactionVm(
        string UserName,
        string Reaction);


    private sealed record ReactionGroupVm(
        string Reaction,
        int Count,
        bool IsMine,
        string UsersText);
}