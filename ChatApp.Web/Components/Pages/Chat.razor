    }


    // ============================================================
    // SEEN TITLE
    // ============================================================

    private string GetSeenTitle(
        MessageVm message)
    {
        if (!message.IsRead)
        {
            return message.IsDelivered
                ? "Delivered to recipient"
                : "Message sent";
        }

        if (!seenTimes.TryGetValue(
                message.Id,
                out var seenAt))
        {
            return "Seen";
        }

        return
            $"Seen at {seenAt.ToLocalTime():dd MMM yyyy HH:mm}";
    }


    // ============================================================
    // AFTER RENDER
    // ============================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender)
        {
            dotNetReference =
                DotNetObjectReference.Create(
                    this);

            try
            {
                await JS.InvokeVoidAsync(
                    "chatApp.initialize");
            }
            catch
            {
            }

            try
            {
                await JS.InvokeVoidAsync(
                    "eval",
                    @"(() => {
                        const api = window.chatApp = window.chatApp || {};
                        api.focusMessageInput = () => {
                            const el = document.querySelector('.composer-input-wrap textarea');
                            if (!el) return;
                            try { el.focus({ preventScroll: true }); } catch { el.focus(); }
                            requestAnimationFrame(() => {
                                try { el.scrollIntoView({ block: 'nearest', inline: 'nearest' }); } catch {}
                            });
                        };
                        api.blurMessageInput = () => {
                            const el = document.querySelector('.composer-input-wrap textarea');
                            try { el?.blur?.(); } catch {}
                            try { document.activeElement?.blur?.(); } catch {}
                        };
                        if (!window.__chatAppMobileViewportBound) {
                            window.__chatAppMobileViewportBound = true;
                            const root = document.documentElement;
                            const syncViewport = () => {
                                const vv = window.visualViewport;
                                const height = vv?.height || window.innerHeight;
                                root.style.setProperty('--chat-visual-height', `${height}px`);
                                root.classList.toggle('chat-keyboard-visible', !!vv && (window.innerHeight - vv.height) > 120);
                            };
                            window.addEventListener('resize', syncViewport, { passive: true });
                            window.visualViewport?.addEventListener('resize', syncViewport, { passive: true });
                            window.visualViewport?.addEventListener('scroll', syncViewport, { passive: true });
                            syncViewport();
                        }
                    })();");
            }
            catch
            {
            }

            // Load photo preview JavaScript module.
            try
            {
                photoModule =
                    await JS.InvokeAsync<IJSObjectReference>(
                        "import",
                        "/js/photoUpload.js");
            }
            catch
            {
                photoModule = null;
            }

            // Load push notification JavaScript module.
            try
            {
                pushModule =
                    await JS.InvokeAsync<IJSObjectReference>(
                        "import",
                        "/js/pushNotifications.js");
            }
            catch
            {
                pushModule = null;
            }

            // Restore notification state from the browser's actual
            // Push subscription after every page load/refresh.
            try
            {
                if (pushModule is not null)
                {
                    notificationsEnabled =
                        await pushModule.InvokeAsync<bool>(
                            "isNotificationsEnabled");
                }
            }
            catch
            {
                notificationsEnabled = false;
            }

            // Register this ChatApp tab with the service worker
            // so notification clicks can target the exact room tab.
            try
            {
                if (pushModule is not null)
                {
                    await pushModule.InvokeVoidAsync(
                        "registerChatTab",
                        RoomCode);
                }
            }
            catch
            {
            }

            // Get actual browser origin.
            try
            {
                var browserOrigin =
                    await JS.InvokeAsync<string>(
                        "eval",
                        "window.location.origin");

                if (!string.IsNullOrWhiteSpace(
                        browserOrigin))
                {
                    var normalized =
                        browserOrigin.TrimEnd('/');

                    if (!string.Equals(
                            publicOrigin,
                            normalized,
                            StringComparison.OrdinalIgnoreCase))
                    {
                        publicOrigin =
                            normalized;

                        await InvokeAsync(
                            StateHasChanged);
                    }
                }
            }
            catch
            {
            }

            if (hasJoined && !string.IsNullOrWhiteSpace(name))
            {
                await SaveCurrentNameAsync();
            }

            // A notification click is explicitly marked by the service worker.
            // Restore only the identity previously used in this room.
            if (notificationOpen)
            {
                await RestoreNotificationIdentityAsync();
            }
        }

        if (hasJoined &&
            connected &&
            dotNetReference is not null)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "chatApp.observeMessages",
                    dotNetReference);
            }
            catch
            {
            }
        }
    }


