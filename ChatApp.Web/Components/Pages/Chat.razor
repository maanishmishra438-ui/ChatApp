    // ============================================================
    // DISPOSE
    // ============================================================

    public async ValueTask DisposeAsync()
    {
        try
        {
            typingCts?.Cancel();

            typingCts?.Dispose();
        }
        catch
        {
        }


        try
        {
            seenTimerCts?.Cancel();

            seenTimerCts?.Dispose();
        }
        catch
        {
        }


        try
        {
            seenTimer?.Dispose();
        }
        catch
        {
        }


        try
        {
            dotNetReference?.Dispose();
        }
        catch
        {
        }


        try
        {
            if (hub is not null)
            {
                await hub.DisposeAsync();
            }
        }
        catch
        {
        }
    }


    // ============================================================
