    // ============================================================
    // SEEN TIMER
    // ============================================================

    private void StartSeenTimer()
    {
        if (seenTimer is not null)
        {
            return;
        }


        seenTimerCts =
            new CancellationTokenSource();


        seenTimer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(15));


        _ =
            RunSeenTimerAsync(
                seenTimerCts.Token);
    }


    private async Task RunSeenTimerAsync(
        CancellationToken token)
    {
        try
        {
            while (
                seenTimer is not null &&
                await seenTimer.WaitForNextTickAsync(
                    token))
            {
                if (seenTimes.Count > 0)
                {
                    await InvokeAsync(
                        StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
    }


    // ============================================================
    // SEEN TEXT
    // ============================================================

    private string GetSeenText(
        MessageVm message)
    {
        if (!message.IsRead)
        {
            return "Sent";
        }


        if (!seenTimes.TryGetValue(
                message.Id,
                out var seenAt))
        {
            return "Seen";
        }


        var elapsed =
            DateTime.UtcNow - seenAt;


        if (elapsed.TotalSeconds < 60)
        {
            return "Seen just now";
        }


        if (elapsed.TotalMinutes < 60)
        {
            var minutes =
                Math.Max(
                    1,
                    (int)Math.Floor(
                        elapsed.TotalMinutes));


            return minutes == 1
                ? "Seen 1 min ago"
                : $"Seen {minutes} min ago";
        }


        if (elapsed.TotalHours < 24)
        {
            var hours =
                Math.Max(
                    1,
                    (int)Math.Floor(
                        elapsed.TotalHours));


            return hours == 1
                ? "Seen 1 hr ago"
                : $"Seen {hours} hrs ago";
        }


        if (elapsed.TotalDays < 7)
        {
            var days =
                Math.Max(
                    1,
                    (int)Math.Floor(
                        elapsed.TotalDays));


            return days == 1
                ? "Seen 1 day ago"
                : $"Seen {days} days ago";
        }


        return
            $"Seen {seenAt.ToLocalTime():dd MMM}";
    }


    // ============================================================
    // SEEN TITLE
    // ============================================================

    private string GetSeenTitle(
        MessageVm message)
    {
        if (!message.IsRead)
        {
            return "Delivered";
        }


        if (!seenTimes.TryGetValue(
                message.Id,
                out var seenAt))
        {
            return "Seen";
        }


        return
            $"Seen at {seenAt.ToLocalTime():dd MMM yyyy HH:mm}";
    }


