    // ============================================================

    private bool HasUserReaction(
        MessageVm message,
        string reaction)
    {
        return message.ReactionItems.Any(
            x =>
                x.UserName.Equals(
                    name,
                    StringComparison.OrdinalIgnoreCase) &&
                x.Reaction ==
                    reaction);
    }


    // ============================================================
    // REACTION GROUPS
    // ============================================================

    private IEnumerable<ReactionGroupVm>
        GetReactionGroups(
            MessageVm message)
    {
        return message.ReactionItems
            .GroupBy(
                x =>
                    x.Reaction)
            .Select(
                group =>
                {
                    var users =
                        group
                            .Select(
                                x =>
                                    x.UserName)
                            .Distinct(
                                StringComparer.OrdinalIgnoreCase)
                            .ToList();


                    var isMine =
                        users.Any(
                            x =>
                                x.Equals(
                                    name,
                                    StringComparison.OrdinalIgnoreCase));


                    var usersText =
                        users.Count switch
                        {
                            0 =>
                                string.Empty,

                            <= 3 =>
                                string.Join(
                                    ", ",
                                    users),

                            _ =>
                                $"{users.Count} people reacted"
                        };


                    return new ReactionGroupVm(
                        group.Key,
                        group.Count(),
                        isMine,
                        usersText);
                });
    }


