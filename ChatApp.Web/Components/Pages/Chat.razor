    // ============================================================
    // OFFLINE PARTICIPANT CLEANUP
    // ============================================================

    private void CancelOfflineRemoval(
        string userName)
    {
        if (offlineRemovalTimers.TryGetValue(
                userName,
                out var cts))
        {
            offlineRemovalTimers.Remove(userName);

            try
            {
                cts.Cancel();
                cts.Dispose();
            }
            catch
            {
            }
        }
    }


    private void ScheduleOfflineRemoval(
        string userName)
    {
        CancelOfflineRemoval(userName);

        var cts =
            new CancellationTokenSource();

        offlineRemovalTimers[userName] =
            cts;

        _ =
            RemoveOfflineParticipantLaterAsync(
                userName,
                cts);
    }


    private async Task RemoveOfflineParticipantLaterAsync(
        string userName,
        CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(
                OfflineRemovalDelay,
                cts.Token);

            await InvokeAsync(() =>
            {
                if (onlineUsers.Contains(userName))
                {
                    return;
                }

                knownParticipants.Remove(userName);

                offlineRemovalTimers.Remove(
                    userName);

                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
        finally
        {
            if (offlineRemovalTimers.TryGetValue(
                    userName,
                    out var current) &&
                ReferenceEquals(current, cts))
            {
                offlineRemovalTimers.Remove(
                    userName);
            }

            try
            {
                cts.Dispose();
            }
            catch
            {
            }
        }
    }


    // ============================================================
    // INITIALIZE
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            RoomCode =
                RoomCode
                    .Trim()
                    .ToLowerInvariant();

            var uri =
                Navigation.ToAbsoluteUri(
                    Navigation.Uri);

            var query =
                Microsoft.AspNetCore.WebUtilities
                    .QueryHelpers
                    .ParseQuery(uri.Query);

            if (query.TryGetValue(
                    "name",
                    out var queryName))
            {
                QueryName =
                    queryName.ToString();
            }

            publicOrigin =
                uri.GetLeftPart(
                    UriPartial.Authority);

            var exists =
                await ChatService.RoomExistsAsync(
                    RoomCode);

            if (!exists)
            {
                Navigation.NavigateTo("/");

                return;
            }

            if (!string.IsNullOrWhiteSpace(QueryName))
            {
                var existingName =
                    QueryName.Trim();

                if (existingName.Length > 40)
                {
                    existingName =
                        existingName[..40];
                }

                if (!string.IsNullOrWhiteSpace(
                        existingName))
                {
                    name =
                        existingName;

                    joinName =
                        existingName;

                    hasJoined =
                        true;

                    await InitializeChatAsync();
                }
            }
        }
        catch (Exception ex)
        {
            error =
                ex.Message;

            joinError =
                ex.Message;
        }
        finally
        {
            isInitializing = false;
        }
    }


    // ============================================================
    // JOIN
    // ============================================================

    private async Task JoinChat()
    {
        joinError = null;
        error = null;

        var enteredName =
            joinName.Trim();

        if (string.IsNullOrWhiteSpace(
                enteredName))
        {
            joinError =
                "Please enter your name.";

            return;
        }

        if (enteredName.Length < 2)
        {
            joinError =
                "Name must be at least 2 characters.";

            return;
        }

        if (enteredName.Length > 40)
        {
            joinError =
                "Name cannot be longer than 40 characters.";

            return;
        }

        isJoining = true;

        try
        {
            name =
                enteredName;

            var exists =
                await ChatService.RoomExistsAsync(
                    RoomCode);

            if (!exists)
            {
                joinError =
                    "This chat room does not exist.";

                return;
            }

            hasJoined = true;

            await InvokeAsync(
                StateHasChanged);

            await InitializeChatAsync();
        }
        catch (Exception ex)
        {
            hasJoined = false;

            joinError =
                $"Unable to join chat: {ex.Message}";
        }
        finally
        {
            isJoining = false;
        }
    }


