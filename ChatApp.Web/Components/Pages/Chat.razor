    // ============================================================
    // OFFLINE PARTICIPANT CLEANUP
    // ============================================================

    private void CancelOfflineRemoval(
        string userName)
    {
        if (offlineRemovalTimers.TryGetValue(
                userName,
                out var cts))
        {
            offlineRemovalTimers.Remove(userName);

            try
            {
                cts.Cancel();
                cts.Dispose();
            }
            catch
            {
            }
        }
    }


    private void ScheduleOfflineRemoval(
        string userName)
    {
        CancelOfflineRemoval(userName);

        var cts =
            new CancellationTokenSource();

        offlineRemovalTimers[userName] =
            cts;

        _ =
            RemoveOfflineParticipantLaterAsync(
                userName,
                cts);
    }


    private async Task RemoveOfflineParticipantLaterAsync(
        string userName,
        CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(
                OfflineRemovalDelay,
                cts.Token);

            await InvokeAsync(() =>
            {
                if (onlineUsers.Contains(userName))
                {
                    return;
                }

                knownParticipants.Remove(userName);

                offlineRemovalTimers.Remove(
                    userName);

                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
        finally
        {
            if (offlineRemovalTimers.TryGetValue(
                    userName,
                    out var current) &&
                ReferenceEquals(current, cts))
            {
                offlineRemovalTimers.Remove(
                    userName);
            }

            try
            {
                cts.Dispose();
            }
            catch
            {
            }
        }
    }


    // ============================================================
    // INITIALIZE
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            RoomCode =
                RoomCode
                    .Trim()
                    .ToLowerInvariant();

            var uri =
                Navigation.ToAbsoluteUri(
                    Navigation.Uri);

            var query =
                Microsoft.AspNetCore.WebUtilities
                    .QueryHelpers
                    .ParseQuery(uri.Query);

            if (query.TryGetValue(
                    "name",
                    out var queryName))
            {
                QueryName =
                    queryName.ToString();
            }

            notificationOpen =
                query.TryGetValue(
                    "notification",
                    out var notificationValue) &&
                (string.Equals(
                    notificationValue.ToString(),
                    "1",
                    StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(
                    notificationValue.ToString(),
                    "true",
                    StringComparison.OrdinalIgnoreCase));

            publicOrigin =
                uri.GetLeftPart(
                    UriPartial.Authority);

            var exists =
                await ChatService.RoomExistsAsync(
                    RoomCode);

            if (!exists)
            {
                Navigation.NavigateTo("/");

                return;
            }

            if (!string.IsNullOrWhiteSpace(QueryName))
            {
                var existingName =
                    QueryName.Trim();

                if (existingName.Length > 40)
                {
                    existingName =
                        existingName[..40];
                }

                if (!string.IsNullOrWhiteSpace(
                        existingName))
                {
                    name =
                        existingName;

                    joinName =
                        existingName;

                    hasJoined =
                        true;

                    await InitializeChatAsync();
                }
            }
        }
        catch (Exception ex)
        {
            error =
                ex.Message;

            joinError =
                ex.Message;
        }
        finally
        {
            // Normal invite links should immediately show the name screen.
            // Notification opens remain in loading state until the saved
            // room-specific identity has been restored in OnAfterRenderAsync.
            isInitializing = notificationOpen;
        }
    }


    // ============================================================
    // JOIN
    // ============================================================

    private async Task JoinChat()
    {
        joinError = null;
        error = null;

        var enteredName =
            joinName.Trim();

        if (string.IsNullOrWhiteSpace(
                enteredName))
        {
            joinError =
                "Please enter your name.";

            return;
        }

        if (enteredName.Length < 2)
        {
            joinError =
                "Name must be at least 2 characters.";

            return;
        }

        if (enteredName.Length > 40)
        {
            joinError =
                "Name cannot be longer than 40 characters.";

            return;
        }

        isJoining = true;

        try
        {
            name =
                enteredName;

            var exists =
                await ChatService.RoomExistsAsync(
                    RoomCode);

            if (!exists)
            {
                joinError =
                    "This chat room does not exist.";

                return;
            }

            await SaveCurrentNameAsync();

            hasJoined = true;

            await InvokeAsync(
                StateHasChanged);

            await InitializeChatAsync();
        }
        catch (Exception ex)
        {
            hasJoined = false;

            joinError =
                $"Unable to join chat: {ex.Message}";
        }
        finally
        {
            isJoining = false;
        }
    }


    // ============================================================
    // STORED IDENTITY HELPERS
    // ============================================================

    private async Task SaveCurrentNameAsync()
    {
        if (string.IsNullOrWhiteSpace(name) ||
            string.IsNullOrWhiteSpace(RoomCode))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                SavedNameStorageKey,
                name);
        }
        catch
        {
            // Local storage is a convenience for notification routing.
            // Chat functionality must continue if storage is unavailable.
        }
    }


    private async Task<string?> GetSavedNameAsync()
    {
        if (string.IsNullOrWhiteSpace(RoomCode))
        {
            return null;
        }

        try
        {
            return await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                SavedNameStorageKey);
        }
        catch
        {
            return null;
        }
    }


    private async Task RestoreNotificationIdentityAsync()
    {
        if (!notificationOpen ||
            notificationAutoJoinAttempted ||
            hasJoined)
        {
            return;
        }

        notificationAutoJoinAttempted = true;

        try
        {
            var savedName =
                (await GetSavedNameAsync())?.Trim();

            if (string.IsNullOrWhiteSpace(savedName))
            {
                isInitializing = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (savedName.Length > 40)
            {
                savedName = savedName[..40];
            }

            if (savedName.Length < 2)
            {
                isInitializing = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            name = savedName;
            joinName = savedName;
            hasJoined = true;

            await InitializeChatAsync();
        }
        catch
        {
            hasJoined = false;
            joinError =
                "Your saved chat identity could not be restored. Please enter your name to continue.";
        }
        finally
        {
            isInitializing = false;
            await InvokeAsync(StateHasChanged);
        }
    }


