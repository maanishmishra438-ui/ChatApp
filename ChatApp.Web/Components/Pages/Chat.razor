    private async Task HandlePhotoSelected(InputFileChangeEventArgs e)
    {
        photoError = null;

        var file = e.File;

        if (file is null)
        {
            return;
        }

        if (file.Size <= 0 || file.Size > MaxPhotoSize)
        {
            photoError = "Photo must be 10 MB or smaller.";
            await CancelPhotoSelection();
            return;
        }

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            photoError = "Please select a valid image.";
            await CancelPhotoSelection();
            return;
        }

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (extension is not ".jpg" and
            not ".jpeg" and
            not ".png" and
            not ".gif" and
            not ".webp")
        {
            photoError = "Supported formats: JPG, JPEG, PNG, GIF and WEBP.";
            await CancelPhotoSelection();
            return;
        }

        try
        {
            selectedPhoto = file;

            if (photoModule is null)
            {
                photoModule =
                    await JS.InvokeAsync<IJSObjectReference>(
                        "import",
                        "/js/photoUpload.js");
            }

            selectedPhotoPreviewUrl =
                await photoModule.InvokeAsync<string>(
                    "createPreview",
                    "photoInput");

            if (string.IsNullOrWhiteSpace(selectedPhotoPreviewUrl))
            {
                await CancelPhotoSelection();
                photoError = "Unable to preview the selected photo.";
                return;
            }

            composerEmojiPickerOpen = false;
            mobileComposerEmojiOpen = false;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await CancelPhotoSelection();
            photoError = $"Unable to preview photo: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task CancelPhotoSelection()
    {
        try
        {
            if (photoModule is not null)
            {
                await photoModule.InvokeVoidAsync("clearPreview", "photoInput");
            }
        }
        catch
        {
        }

        selectedPhoto = null;
        selectedPhotoPreviewUrl = null;
        photoSending = false;
        selectedPhotoMode = "Normal";
    }


    private async Task SendPhoto()
    {
        if (selectedPhoto is null ||
            hub is null ||
            !connected ||
            photoSending)
        {
            return;
        }

        photoError = null;
        photoSending = true;

        try
        {
            await using var stream =
                selectedPhoto.OpenReadStream(MaxPhotoSize);

            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);

            var fileBytes = memoryStream.ToArray();

            var replyId = replyingTo?.Id;

            await hub.InvokeAsync(
    "SendPhoto",
    RoomCode,
    name,
    fileBytes,
    selectedPhoto.Name,
    selectedPhoto.ContentType,
    selectedPhotoMode,
    replyId);

            await CancelPhotoSelection();

            replyingTo = null;

            typingUser = null;

            typingCts?.Cancel();

            await BlurMobileComposerAsync();

            await InvokeAsync(StateHasChanged);

            await ScrollToBottomAsync();
        }
        catch (Exception ex)
        {
            photoSending = false;
            photoError = $"Unable to send photo: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }


