@page "/chat/{RoomCode}"

@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using ChatApp.Web.Data

@inject NavigationManager Navigation
@inject ChatApp.Web.Services.ChatService ChatService
@inject IJSRuntime JS

@implements IAsyncDisposable

<style>
    .photo-composer-button {
        position: relative;
        width: 42px;
        height: 42px;
        min-width: 42px;
        border: 0;
        border-radius: 12px;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 20px;
        transition: background .18s ease, transform .18s ease;
    }

        .photo-composer-button:hover {
            background: rgba(0, 0, 0, .06);
            transform: translateY(-1px);
        }

    .photo-composer-input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .photo-preview-card {
        margin: 0 12px 10px;
        padding: 10px;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
    }

    .photo-preview-image {
        display: block;
        width: auto;
        max-width: 280px;
        max-height: 220px;
        height: auto;
        object-fit: contain;
        margin: 0 auto;
        border-radius: 12px;
        background: #f5f5f5;
    }

    .photo-preview-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 10px;
    }

    .photo-preview-info {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .photo-preview-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 600;
    }

    .photo-preview-size {
        font-size: 12px;
        opacity: .65;
    }

    .photo-preview-actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
    }

    .photo-cancel-button,
    .photo-send-button {
        border: 0;
        border-radius: 10px;
        padding: 9px 14px;
        cursor: pointer;
        font-weight: 600;
    }

    .photo-cancel-button {
        background: #f1f1f1;
    }

    .photo-send-button {
        background: #111;
        color: #fff;
    }

        .photo-send-button:disabled,
        .photo-cancel-button:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .photo-mode-picker {
        display: flex;
        gap: 8px;
        padding: 10px 12px 0;
    }

    .photo-mode-option {
        flex: 1;
        border: 1px solid rgba(0,0,0,.12);
        background: #fff;
        border-radius: 12px;
        padding: 9px 10px;
        cursor: pointer;
        text-align: left;
        transition: .18s ease;
    }

        .photo-mode-option.active {
            border-color: #111827;
            box-shadow: 0 0 0 2px rgba(17,24,39,.08);
        }

    .photo-mode-title {
        display: block;
        font-weight: 700;
        font-size: 13px;
    }

    .photo-mode-subtitle {
        display: block;
        font-size: 11px;
        opacity: .62;
        margin-top: 2px;
    }

    .photo-view-once-card {
        width: min(300px,100%);
        min-height: 170px;
        border-radius: 16px;
        background: linear-gradient(135deg,#111827,#374151);
        color: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        border: 0;
        padding: 22px;
    }

    .photo-view-once-icon {
        font-size: 34px;
    }

    .photo-view-once-title {
        font-weight: 800;
    }

    .photo-view-once-subtitle {
        font-size: 12px;
        opacity: .75;
    }

    .photo-message-image {
        display: block;
        width: auto;
        max-width: 240px;
        max-height: 300px;
        height: auto;
        object-fit: contain;
        border-radius: 12px;
        cursor: pointer;
        transition: transform .18s ease, opacity .18s ease;
    }

        .photo-message-image:hover {
            opacity: .95;
        }

    .photo-download-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 190px;
        padding: 14px 16px;
        border-radius: 12px;
        background: rgba(0,0,0,.06);
    }

    .photo-download-icon {
        font-size: 28px;
        line-height: 1;
        margin-bottom: 6px;
    }

    .photo-download-title {
        font-size: 13px;
        font-weight: 800;
    }

    .photo-download-subtitle {
        margin-top: 2px;
        font-size: 11px;
        opacity: .65;
    }

    .photo-download-button {
        display: inline-flex;
        margin-top: 9px;
        padding: 7px 11px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 12px;
        background: rgba(0,0,0,.07);
        color: inherit;
    }

    .photo-viewer-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0,0,0,.92);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .photo-viewer-image {
        max-width: 95vw;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 12px;
    }

    .photo-viewer-close {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 50%;
        background: rgba(255,255,255,.14);
        color: #fff;
        font-size: 26px;
        cursor: pointer;
    }

    .photo-message-card {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(0,0,0,.04);
    }

    .photo-message-icon {
        font-size: 24px;
    }

    .photo-message-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .photo-message-title {
        font-weight: 600;
    }

    .photo-message-name {
        font-size: 12px;
        opacity: .65;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

<PageTitle>Private Chat</PageTitle>

@if (!isInitializing && !hasJoined)
{
    <div class="join-screen">

        <div class="join-card">

            <div class="join-brand">
                <div class="join-brand-icon">
                    🔒
                </div>

                <div class="join-brand-name">
                    Chat<span>App</span>
                </div>
            </div>

            <div class="room-badge">
                <span class="room-badge-dot"></span>
                PRIVATE ROOM
            </div>

            <div class="join-hero-icon">
                <div class="join-hero-icon-inner">
                    🔐
                </div>
            </div>

            <h1>
                Join Private Chat
            </h1>

            <p class="join-description">
                Enter your display name to join this private conversation.
            </p>

            <div class="join-form">

                <label for="displayName">
                    Display name
                </label>

                <div class="name-input-wrapper">

                    <span class="name-input-icon">
                        👤
                    </span>

                    <input id="displayName"
                           @bind="joinName"
                           @bind:event="oninput"
                           maxlength="40"
                           autocomplete="off"
                           placeholder="e.g. Manish"
                           @onkeydown="HandleJoinKeyDown" />

                    @if (!string.IsNullOrWhiteSpace(joinName))
                    {
                        <span class="input-check">
                            ✓
                        </span>
                    }

                </div>

                @if (!string.IsNullOrWhiteSpace(joinError))
                {
                    <div class="join-error">
                        <span>!</span>
                        @joinError
                    </div>
                }

                <button class="join-button"
                        @onclick="JoinChat"
                        disabled="@(isJoining || string.IsNullOrWhiteSpace(joinName))">

                    @if (isJoining)
                    {
                        <span class="join-spinner"></span>

                        <span>
                            Joining...
                        </span>
                    }
                    else
                    {
                        <span>
                            Join Chat
                        </span>

                        <span class="join-arrow">
                            →
                        </span>
                    }

                </button>

            </div>

            <div class="join-privacy">

                <div class="privacy-icon">
                    🔒
                </div>

                <div class="privacy-content">

                    <strong>
                        Private conversation
                    </strong>

                    <span>
                        Anyone with the room link can enter this conversation.
                    </span>

                </div>

            </div>

            <div class="join-footer">
                <span>Real-time messaging</span>
                <span class="footer-separator">•</span>
                <span>Private room</span>
                <span class="footer-separator">•</span>
                <span>Messages saved</span>
            </div>

        </div>

    </div>
}
else
{
    <div class="chat-shell">

        <!-- ============================================================
             TOP BAR
             ============================================================ -->

        <header class="topbar">

            <a class="logo"
               href="/">
                Chat<span>App</span>
            </a>

            <div class="top-actions">

                <div class="user-chip">

                    <span class="user-chip-avatar">
                        @Initial
                    </span>

                    <span class="user-chip-name">
                        @name
                    </span>

                </div>

                <span class="connection">

                    <i class="@(connected ? "online" : "offline")"></i>

                    @(connected ? "Connected" : "Connecting…")

                </span>

                <!-- =====================================================
                     NOTIFICATIONS
                     ===================================================== -->

                <button type="button"
                        class="share-button notification-button"
                        @onclick="EnableNotifications"
                        disabled="@notificationBusy">

                    <span class="share-icon">
                        🔔
                    </span>

                    @if (notificationBusy)
                    {
                        <span>Enabling...</span>
                    }
                    else if (notificationsEnabled)
                    {
                        <span>Notifications on</span>
                    }
                    else
                    {
                        <span>Enable notifications</span>
                    }

                </button>

                <button class="share-button"
                        @onclick="CopyInvite">

                    <span class="share-icon">
                        ↗
                    </span>

                    Copy invite link

                </button>

                <button class="leave-button"
                        @onclick="OpenLeaveModal"
                        disabled="@isLeaving">

                    <span class="leave-icon">
                        ↪
                    </span>

                    Leave room

                </button>

            </div>

        </header>


        <!-- ============================================================
             MAIN LAYOUT
             ============================================================ -->

        <main class="chat-layout">

            <!-- ========================================================
                 SIDEBAR
                 ======================================================== -->

            <aside class="side-panel">

                <div class="avatar">
                    @Initial
                </div>

                <h2>
                    Private chat
                </h2>

                <p>
                    Send this invite link to the person you want to chat with.
                </p>

                <div class="invite">

                    <small>
                        INVITE LINK
                    </small>

                    <div class="invite-url">
                        @InviteUrl
                    </div>

                    <button @onclick="CopyInvite">
                        Copy link
                    </button>

                </div>

                <div class="warning">
                    Keep the link private.
                    Anyone with the link can enter this room.
                </div>


                <!-- ====================================================
                     ROOM MEMBERS
                     ==================================================== -->

                <div class="presence-card">

                    <div class="presence-card-header">

                        <span class="presence-card-title">
                            ROOM MEMBERS
                        </span>

                        <span class="presence-card-count">
                            @knownParticipants.Count
                        </span>

                    </div>

                    <div class="presence-member-list">

                        @foreach (var participant in ParticipantNames)
                        {
                            var participantOnline =
                            IsUserOnline(participant);

                            <div class="presence-member">

                                <div class="presence-member-avatar">
                                    @(participant.Trim()[0].ToString().ToUpperInvariant())
                                </div>

                                <div class="presence-member-info">

                                    <span class="presence-member-name">

                                        @participant

                                        @if (participant.Equals(
                                                                        name,
                                                                        StringComparison.OrdinalIgnoreCase))
                                        {
                                            <small>
                                                You
                                            </small>
                                        }

                                </span>

                                <span class="presence-member-status @(participantOnline ? "online" : "offline")">

                                    <i></i>

                                    @(participantOnline
                                                                    ? "Online"
                                                                    : "Offline")

                            </span>

                                </div>

                            </div>
                                        }

                    </div>

                </div>


                <button class="side-leave-button"
                        @onclick="OpenLeaveModal"
                        disabled="@isLeaving">

                    <span>
                        ↪
                    </span>

                    Leave this room

                </button>

            </aside>


            <!-- ========================================================
                 CONVERSATION
                 ======================================================== -->

            <section class="conversation">

                <div class="conversation-header">

                    <div>

                        <div class="conversation-title-row">

                            <h3>
                                Private Room
                            </h3>

                            <span class="room-private-pill">
                                Private
                            </span>

                        </div>

                        <span class="room-code-label">
                            Room @RoomCode
                        </span>

                    </div>

                    <div class="room-status presence-summary">

                        <span class="status-dot"></span>

                        @if (onlineUsers.Count == 0)
                        {
                            <span>
                                Offline
                            </span>
                        }
                        else if (onlineUsers.Count == 1)
                        {
                            <span>
                                1 person online
                            </span>
                        }
                        else
                        {
                            <span>
                                @onlineUsers.Count people online
                            </span>
                        }

                    </div>

                    <button type="button"
                            class="mobile-info-button"
                            @onclick="OpenMobileInfo"
                            aria-label="Open room information"
                            title="Room info">

                        <span>ⓘ</span>

                    </button>

                </div>


                <!-- =====================================================
                     MESSAGES
                     ===================================================== -->

                <div class="messages"
                     @ref="messagesContainer"
                     @onclick="CloseFloatingActions">

                    @if (messages.Count == 0)
                    {
                        <div class="empty">

                            <div class="spark">
                                ✦
                            </div>

                            <h4>
                                No messages yet
                            </h4>

                            <p>
                                Send the first message.
                            </p>

                        </div>
                    }
                    else
                    {
                        @foreach (var message in messages)
                        {
                            var mine = IsMine(message);

                            <div class="message-row @(mine ? "mine" : "theirs")"
                                 data-message-id="@message.Id"
                                 data-is-read="@message.IsRead.ToString().ToLowerInvariant()"
                                 @onclick:stopPropagation="true">

                                <!-- REACTION / EMOJI PICKER -->
                                @if (reactionPickerMessageId == message.Id &&
                                                    !message.IsDeleted)
                                {
                                    <div class="reaction-picker"
                                         @onclick:stopPropagation="true">

                                        <div class="reaction-quick-row">
                                            @foreach (var reaction in QuickReactionOptions)
                                            {
                                                <button type="button"
                                                        class="reaction-picker-button @(HasUserReaction(message, reaction) ? "selected" : "")"
                                                        @onclick="() => ReactToMessage(message, reaction)"
                                                        title="React with @reaction"
                                                        aria-label="React with @reaction">
                                                    @reaction
                                                </button>
                                            }

                                            <button type="button"
                                                    class="reaction-picker-button emoji-more-button"
                                                    @onclick="() => ToggleEmojiBrowser(message.Id)"
                                                    title="More emojis"
                                                    aria-label="More emojis">
                                                +
                                            </button>
                                        </div>

                                        @if (emojiBrowserMessageId == message.Id)
                                        {
                                            <div class="emoji-browser">
                                                <div class="emoji-browser-header">
                                                    <div class="emoji-browser-title">
                                                        <span>Emoji</span>
                                                        <small>Choose a reaction</small>
                                                    </div>

                                                    <button type="button"
                                                            class="emoji-browser-close"
                                                            @onclick="CloseEmojiBrowser"
                                                            title="Close emoji picker"
                                                            aria-label="Close emoji picker">
                                                        ×
                                                    </button>
                                                </div>

                                                <div class="emoji-search-wrap">
                                                    <span class="emoji-search-icon">⌕</span>
                                                    <input class="emoji-search"
                                                           @bind="emojiSearch"
                                                           @bind:event="oninput"
                                                           placeholder="Search emoji..."
                                                           autocomplete="off"
                                                           aria-label="Search emoji" />
                                                </div>

                                                <div class="emoji-category-row">
                                                    @foreach (var category in EmojiCategories)
                                                    {
                                                        <button type="button"
                                                                class="emoji-category-button @(emojiCategory == category.Key ? "active" : "")"
                                                                @onclick="() => SelectEmojiCategory(category.Key)"
                                                                title="@category.Value.Name"
                                                                aria-label="@category.Value.Name">
                                                            @category.Value.Icon
                                                        </button>
                                                    }
                                                </div>

                                                <div class="emoji-grid">
                                                    @foreach (var emoji in GetFilteredEmojis())
                                                    {
                                                        <button type="button"
                                                                class="emoji-grid-button @(HasUserReaction(message, emoji) ? "selected" : "")"
                                                                @onclick="() => ReactToMessage(message, emoji)"
                                                                title="React with @emoji"
                                                                aria-label="React with @emoji">
                                                            @emoji
                                                        </button>
                                                    }
                                                </div>

                                            </div>
                                        }

                                    </div>
                                }


                                <!-- MESSAGE BUBBLE -->

                                <div class="bubble">

                                    @if (message.IsDeleted)
                                    {
                                        <div class="deleted-message">

                                            <span class="deleted-message-icon">
                                                ◌
                                            </span>

                                            <span class="deleted-message-text">
                                                This message was deleted
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        @if (message.ReplyToMessageId.HasValue &&
                                                                !string.IsNullOrWhiteSpace(message.ReplyToText))
                                        {
                                            <div class="quoted-message">

                                                <div class="quoted-message-line"></div>

                                                <div class="quoted-message-content">

                                                    <span class="quoted-message-sender">
                                                        @message.ReplyToSender
                                                    </span>

                                                    <span class="quoted-message-text">
                                                        @(GetReplyPreview(message.ReplyToText))
                                                    </span>

                                                </div>

                                            </div>
                                        }

                                        @if (!mine)
                                        {
                                            <strong>
                                                @message.Sender
                                            </strong>
                                        }

                                        @if (message.MessageType.Equals("Photo", StringComparison.OrdinalIgnoreCase))
                                        {
                                            @if (string.Equals(message.PhotoMode, "ViewOnce", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button type="button" class="photo-view-once-card" @onclick="() => OpenViewOncePhoto(message)">
                                                    <span class="photo-view-once-icon">👁️</span>
                                                    <span class="photo-view-once-title">View once photo</span>
                                                    <span class="photo-view-once-subtitle">Tap to open. It can only be viewed once.</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="photo-download-card">
                                                    <span class="photo-download-icon">📷</span>
                                                    <span class="photo-download-title">Photo</span>
                                                    <span class="photo-download-subtitle">Download to view</span>

                                                    @if (!string.IsNullOrWhiteSpace(message.MediaFileName))
                                                    {
                                                        <a class="photo-download-button" href="@GetPhotoUrl(message, true)" download="@message.MediaFileName">⬇ Download</a>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="message-text">
                                                @message.Text
                                            </div>
                                        }
                                    }


                                    <!-- REACTIONS -->
                                    @if (!message.IsDeleted &&
                                                            message.ReactionItems.Count > 0)
                                    {
                                        <div class="message-reactions">

                                            @foreach (var group in GetReactionGroups(message))
                                            {
                                                <button type="button"
                                                        class="reaction-chip @(group.IsMine ? "mine" : "")"
                                                        @onclick="() => ReactToMessage(message, group.Reaction)"
                                                        title="@group.UsersText">

                                                    <span class="reaction-emoji">
                                                        @group.Reaction
                                                    </span>

                                                    <span class="reaction-count">
                                                        @group.Count
                                                    </span>

                                                </button>
                                            }

                                        </div>
                                    }


                                <!-- FOOTER -->

                                <div class="message-footer">

                                    <time>
                                        @(message.SentAt
                                                                        .ToLocalTime()
                                                                        .ToString("HH:mm"))
                            </time>

                            @if (mine)
                                        {
                                            @if (message.IsDeleted)
                                            {
                                                <span class="message-read deleted-status">
                                                    Deleted
                                                </span>
                                            }
                                            else if (message.IsRead)
                                            {
                                                <span class="message-read seen"
                                                      title="@GetSeenTitle(message)">
                                                    ✓✓ Seen
                                                </span>
                                            }
                                            else if (message.IsDelivered)
                                            {
                                                <span class="message-read seen"
                                                      title="Delivered to recipient">
                                                    ✓✓ Delivered
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="message-read sent"
                                                      title="Message sent">
                                                    ✓ Sent
                                                </span>
                                            }
                                        }

                                    </div>

                                </div>


                                <!-- MESSAGE ACTIONS -->
                                @if (!message.IsDeleted)
                                {
                                    <div class="message-hover-actions"
                                         @onclick:stopPropagation="true">

                                        <button type="button"
                                                class="message-tool-button reaction-trigger"
                                                @onclick="() => ToggleReactionPicker(message.Id)"
                                                title="React to this message">

                                            <span class="message-tool-icon">
                                                😊
                                            </span>

                                            <span class="message-tool-label">
                                                React
                                            </span>

                                        </button>


                                        <button type="button"
                                                class="reply-message-button"
                                                @onclick="() => StartReply(message)"
                                                title="Reply to this message">

                                            <span class="reply-message-icon">
                                                ↩
                                            </span>

                                            <span>
                                                Reply
                                            </span>

                                        </button>


                                        <div class="message-menu-wrap">

                                            <button type="button"
                                                    class="message-menu-button"
                                                    @onclick="() => ToggleMessageMenu(message.Id)"
                                                    title="Message options">

                                                ⋯

                                            </button>

                                            @if (openMenuMessageId == message.Id)
                                            {
                                                <div class="message-action-menu"
                                                     @onclick:stopPropagation="true">

                                                    <button type="button"
                                                            class="message-action-item"
                                                            @onclick="() => AskDeleteForMe(message)">

                                                        <span class="message-action-icon">
                                                            ◯
                                                        </span>

                                                        <span>
                                                            Delete for me
                                                        </span>

                                                    </button>

                                                    @if (mine)
                                                    {
                                                        <button type="button"
                                                                class="message-action-item danger"
                                                                @onclick="() => AskUnsend(message)">

                                                            <span class="message-action-icon">
                                                                ↶
                                                            </span>

                                                            <span>
                                                                Unsend
                                                            </span>

                                                        </button>
                                                    }

                                                </div>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                    }

                </div>


                <!-- TYPING -->
                @if (!string.IsNullOrWhiteSpace(typingUser))
                {
                    <div class="typing">

                        <span>
                            @typingUser is typing
                        </span>

                        <span class="typing-dots">
                            <i></i>
                            <i></i>
                            <i></i>
                        </span>

                    </div>
                }


                <!-- REPLY PREVIEW -->
                @if (replyingTo is not null)
                {
                    <div class="reply-preview">

                        <div class="reply-preview-accent"></div>

                        <div class="reply-preview-icon">
                            ↩
                        </div>

                        <div class="reply-preview-content">

                            <span class="reply-preview-label">
                                Replying to @replyingTo.Sender
                            </span>

                            <span class="reply-preview-text">
                                @(GetReplyPreview(replyingTo.Text))
                            </span>

                        </div>

                        <button type="button"
                                class="reply-preview-close"
                                @onclick="CancelReply"
                                title="Cancel reply">

                            ×

                        </button>

                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(photoError))
                {
                    <div class="toast" style="position:relative; margin:0 12px 8px;">
                        @photoError
                    </div>
                }

                @if (selectedPhoto is not null && !string.IsNullOrWhiteSpace(selectedPhotoPreviewUrl))
                {
                    <div class="photo-preview-card">
                        <img class="photo-preview-image"
                             src="@selectedPhotoPreviewUrl"
                             alt="Selected photo preview" />

                        <div class="photo-mode-picker">
                            <button type="button" class="photo-mode-option @(selectedPhotoMode == "Normal" ? "active" : "")" @onclick='() => selectedPhotoMode = "Normal"' disabled="@photoSending">
                                <span class="photo-mode-title">∞ View unlimited</span>
                                <span class="photo-mode-subtitle">Receiver can open and download it.</span>
                            </button>
                            <button type="button" class="photo-mode-option @(selectedPhotoMode == "ViewOnce" ? "active" : "")" @onclick='() => selectedPhotoMode = "ViewOnce"' disabled="@photoSending">
                                <span class="photo-mode-title">👁️ View once</span>
                                <span class="photo-mode-subtitle">Receiver can open it only once.</span>
                            </button>
                        </div>

                        <div class="photo-preview-footer">
                            <div class="photo-preview-info">
                                <span class="photo-preview-name">@selectedPhoto.Name</span>
                                <span class="photo-preview-size">@FormatFileSize(selectedPhoto.Size)</span>
                            </div>

                            <div class="photo-preview-actions">
                                <button type="button"
                                        class="photo-cancel-button"
                                        @onclick="CancelPhotoSelection"
                                        disabled="@photoSending">
                                    Cancel
                                </button>

                                <button type="button"
                                        class="photo-send-button"
                                        @onclick="SendPhoto"
                                        disabled="@(!connected || photoSending)">
                                    @(photoSending ? "Sending..." : "Send photo")
                                </button>
                            </div>
                        </div>
                    </div>
                }


                <!-- COMPOSER -->

                <footer class="composer">

                    <label class="photo-composer-button"
                           title="Photo"
                           aria-label="Select photo">
                        📷
                        <InputFile id="photoInput"
                                   OnChange="HandlePhotoSelected"
                                   accept="image/jpeg,image/png,image/gif,image/webp"
                                   class="photo-composer-input" />
                    </label>

                    <button type="button"
                            class="composer-emoji-button composer-emoji-desktop"
                            @onclick="ToggleComposerEmojiPicker"
                            aria-label="Open emoji picker"
                            title="Emoji">
                        😊
                    </button>

                    <button type="button"
                            class="composer-emoji-button composer-emoji-mobile"
                            @onclick="ToggleMobileComposerEmojiPicker"
                            aria-label="Open emoji picker"
                            title="Emoji">
                        😊
                    </button>

                    <div class="composer-input-wrap">
                        <textarea @ref="messageInput"
                                  @bind="draft"
                                  @bind:event="oninput"
                                  @onkeydown="HandleKeyDown"
                                  placeholder="Type a message..."
                                  rows="1"
                                  maxlength="2000"
                                  autocomplete="off"></textarea>

                        @if (mobileComposerEmojiOpen)
                        {
                            <div class="mobile-composer-emoji-panel"
                                 @onclick:stopPropagation="true">
                                <div class="mobile-composer-emoji-header">
                                    <div>
                                        <strong>Emoji</strong>
                                        <span>Tap to add</span>
                                    </div>
                                    <button type="button"
                                            class="mobile-composer-emoji-close"
                                            @onclick="CloseMobileComposerEmojiPicker"
                                            aria-label="Close emoji picker">
                                        ×
                                    </button>
                                </div>

                                <div class="mobile-composer-emoji-grid">
                                    @foreach (var emoji in MobileComposerEmojiOptions)
                                    {
                                        <button type="button"
                                                class="mobile-composer-emoji-item"
                                                @onclick="() => InsertMobileComposerEmoji(emoji)"
                                                aria-label="Insert @emoji">
                                            @emoji
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @if (composerEmojiPickerOpen)
                        {
                            <div class="composer-emoji-picker"
                                 @onclick:stopPropagation="true">

                                <div class="composer-emoji-header">
                                    <div>
                                        <strong>Emoji</strong>
                                        <span>Pick an emoji</span>
                                    </div>

                                    <button type="button"
                                            class="composer-emoji-close"
                                            @onclick="ToggleComposerEmojiPicker"
                                            aria-label="Close emoji picker">
                                        ×
                                    </button>
                                </div>

                                <div class="composer-emoji-search">
                                    <span>⌕</span>
                                    <input @bind="emojiSearch"
                                           @bind:event="oninput"
                                           placeholder="Search emoji..."
                                           autocomplete="off"
                                           aria-label="Search emoji" />
                                </div>

                                <div class="composer-emoji-categories">
                                    @foreach (var category in EmojiCategories)
                                    {
                                        <button type="button"
                                                class="composer-emoji-category @(emojiCategory == category.Key ? "active" : "")"
                                                @onclick="() => SelectEmojiCategory(category.Key)"
                                                title="@category.Value.Name"
                                                aria-label="@category.Value.Name">
                                            @category.Value.Icon
                                        </button>
                                    }
                                </div>

                                <div class="composer-emoji-grid">
                                    @foreach (var emoji in GetFilteredEmojis())
                                    {
                                        <button type="button"
                                                class="composer-emoji-grid-button"
                                                @onclick="() => InsertComposerEmoji(emoji)"
                                                title="@emoji"
                                                aria-label="Insert @emoji">
                                            @emoji
                                        </button>
                                    }
                                </div>

                            </div>
                        }
                    </div>

                    <button class="send"
                            @onclick="Send"
                            disabled="@(!connected || string.IsNullOrWhiteSpace(draft))"
                            title="Send message">
                        →
                    </button>

                </footer>


                <!-- MOBILE INFO -->
                @if (mobileInfoOpen)
                {
                    <div class="mobile-info-backdrop"
                         @onclick="CloseMobileInfo">

                        <aside class="mobile-info-drawer"
                               @onclick:stopPropagation="true">

                            <div class="mobile-info-drawer-header">

                                <div>

                                    <span class="mobile-info-eyebrow">
                                        ROOM INFORMATION
                                    </span>

                                    <h3>
                                        Private chat
                                    </h3>

                                </div>

                                <button type="button"
                                        class="mobile-info-close"
                                        @onclick="CloseMobileInfo"
                                        aria-label="Close room information">

                                    ×

                                </button>

                            </div>


                            <div class="mobile-info-profile">

                                <div class="mobile-info-avatar">
                                    @Initial
                                </div>

                                <div class="mobile-info-profile-text">

                                    <strong>
                                        @name
                                    </strong>

                                    <span>
                                        Current participant
                                    </span>

                                </div>

                            </div>


                            <div class="mobile-info-section">

                                <span class="mobile-info-section-title">
                                    ROOM CODE
                                </span>

                                <div class="mobile-info-room-code">

                                    <span>
                                        @RoomCode
                                    </span>

                                    <button type="button"
                                            @onclick="CopyInvite"
                                            aria-label="Copy invite link">

                                        Copy

                                    </button>

                                </div>

                            </div>


                            <div class="mobile-info-section">

                                <span class="mobile-info-section-title">
                                    CONNECTION
                                </span>

                                <div class="mobile-info-status-row">

                                    <span class="status-dot @(connected ? "online" : "offline")"></span>

                                    <span>
                                        @(connected
                                                                        ? "Connected"
                                                                        : "Connecting…")
                            </span>

                                </div>

                            </div>


                            <div class="mobile-info-section">

                                <div class="mobile-info-members-heading">

                                    <span class="mobile-info-section-title">
                                        ROOM MEMBERS
                                    </span>

                                    <span class="mobile-info-member-count">
                                        @knownParticipants.Count
                                    </span>

                                </div>


                                <div class="mobile-info-members">

                            @foreach (var participant in ParticipantNames)
                                    {
                                        var participantOnline =
                                        IsUserOnline(participant);

                                        <div class="mobile-info-member">

                                            <div class="mobile-info-member-avatar">
                                                @(participant.Trim()[0].ToString().ToUpperInvariant())
                                            </div>

                                            <div class="mobile-info-member-copy">

                                                <span class="mobile-info-member-name">

                                                    @participant

                                                    @if (participant.Equals(
                                                                                            name,
                                                                                            StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <small>
                                                            You
                                                        </small>
                                                    }

                                    </span>

                                    <span class="mobile-info-member-status @(participantOnline ? "online" : "offline")">

                                        <i></i>

                                        @(participantOnline
                                                                                ? "Online"
                                                                                : "Offline")

                                    </span>

                                            </div>

                                        </div>
                                                        }

                                </div>

                            </div>


                            <div class="mobile-info-private-note">

                                <span>
                                    🔒
                                </span>

                                <div>

                                    <strong>
                                        Private conversation
                                    </strong>

                                    <p>
                                        Anyone with this room link can enter the conversation.
                                    </p>

                                </div>

                            </div>


                            <button type="button"
                                    class="mobile-info-leave"
                                    @onclick="OpenLeaveModal"
                                    disabled="@isLeaving">

                                <span>
                                    ↪
                                </span>

                                Leave this room

                            </button>

                        </aside>

                    </div>
                }

            </section>

        </main>

    </div>


    <!-- TOAST -->
    @if (showToast)
    {
        <div class="toast">
            @toastMessage
        </div>
    }


    <!-- NOTIFICATION ERROR -->
    @if (!string.IsNullOrWhiteSpace(notificationError))
    {
        <div class="toast notification-error-toast">
            @notificationError
        </div>
    }


    <!-- LEAVE MODAL -->
    @if (showLeaveModal)
    {
        <div class="leave-modal-backdrop"
             @onclick="CloseLeaveModal">

            <div class="leave-modal"
                 @onclick:stopPropagation="true">

                <div class="leave-modal-icon">
                    ↪
                </div>

                <div class="leave-modal-content">

                    <h3>
                        Leave this room?
                    </h3>

                    <p>
                        You'll disconnect from this conversation.
                        You can join again later using the same room link.
                    </p>

                </div>

                <div class="leave-modal-actions">

                    <button class="stay-button"
                            @onclick="CloseLeaveModal"
                            disabled="@isLeaving">

                        Stay here

                    </button>

                    <button class="confirm-leave-button"
                            @onclick="LeaveRoom"
                            disabled="@isLeaving">

                        @if (isLeaving)
                        {
                            <span class="leave-spinner"></span>

                            <span>
                                Leaving...
                            </span>
                        }
                        else
                        {
                            <span>
                                Leave room
                            </span>

                            <span>
                                →
                            </span>
                        }

                    </button>

                </div>

            </div>

        </div>
    }


    <!-- DELETE MODAL -->
    @if (showDeleteModal &&
                                                             selectedMessage is not null)
    {
        <div class="delete-modal-backdrop"
             @onclick="CloseDeleteModal">

            <div class="delete-modal"
                 @onclick:stopPropagation="true">

                <div class="delete-modal-icon">

                    @if (deleteMode == DeleteMode.Unsend)
                    {
                        <span>
                            ↶
                        </span>
                    }
                    else
                    {
                        <span>
                            ◯
                        </span>
                    }

                </div>

                <div class="delete-modal-content">

                    @if (deleteMode == DeleteMode.Unsend)
                    {
                        <h3>
                            Unsend this message?
                        </h3>

                        <p>
                            This message will be deleted for everyone in this room.
                        </p>
                    }
                    else
                    {
                        <h3>
                            Delete for you?
                        </h3>

                        <p>
                            This message will be removed from your chat history only.
                        </p>
                    }

                    <div class="delete-modal-preview">
                        "@(GetDeletePreview(selectedMessage.Text))"
                    </div>

                </div>

                <div class="delete-modal-actions">

                    <button class="delete-cancel-button"
                            @onclick="CloseDeleteModal"
                            disabled="@isDeleting">

                        Cancel

                    </button>

                    <button class="delete-confirm-button @(deleteMode == DeleteMode.Unsend ? "danger" : "")"
                            @onclick="ConfirmDelete"
                            disabled="@isDeleting">

                        @if (isDeleting)
                        {
                            <span class="delete-spinner"></span>

                            <span>
                                Working...
                            </span>
                        }
                        else if (deleteMode == DeleteMode.Unsend)
                        {
                            <span>
                                Unsend
                            </span>
                        }
                        else
                        {
                            <span>
                                Delete
                            </span>
                        }

                    </button>

                </div>

            </div>

        </div>
    }
}


@if (photoViewerMessage is not null && !string.IsNullOrWhiteSpace(photoViewerUrl))
{
    <div class="photo-viewer-overlay" @onclick="ClosePhotoViewer">
        <button type="button" class="photo-viewer-close" @onclick:stopPropagation="true" @onclick="ClosePhotoViewer">×</button>
        <img class="photo-viewer-image" src="@photoViewerUrl" alt="Photo" @onclick:stopPropagation="true" />
    </div>
}


