    // ============================================================
    // DISPOSE
    // ============================================================

    public async ValueTask DisposeAsync()
    {
        // --------------------------------------------------------
        // STOP TYPING TIMER
        // --------------------------------------------------------

        try
        {
            typingCts?.Cancel();
            typingCts?.Dispose();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // STOP PRESENCE HEARTBEAT
        // --------------------------------------------------------

        try
        {
            presenceHeartbeatCts?.Cancel();
            presenceHeartbeatCts?.Dispose();
        }
        catch
        {
        }

        try
        {
            presenceHeartbeatTimer?.Dispose();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // STOP SEEN TIMER
        // --------------------------------------------------------

        try
        {
            seenTimerCts?.Cancel();
            seenTimerCts?.Dispose();
        }
        catch
        {
        }

        try
        {
            seenTimer?.Dispose();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // STOP OFFLINE REMOVAL TIMERS
        // --------------------------------------------------------

        try
        {
            foreach (
                var cts
                in offlineRemovalTimers.Values.ToList())
            {
                try
                {
                    cts.Cancel();
                    cts.Dispose();
                }
                catch
                {
                }
            }

            offlineRemovalTimers.Clear();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // DISPOSE DOTNET REFERENCE
        // --------------------------------------------------------

        try
        {
            dotNetReference?.Dispose();
        }
        catch
        {
        }


        // --------------------------------------------------------
        // UNREGISTER CHAT TAB FROM SERVICE WORKER
        // --------------------------------------------------------

        try
        {
            if (pushModule is not null)
            {
                await pushModule.InvokeVoidAsync(
                    "unregisterChatTab");
            }
        }
        catch
        {
        }


        // --------------------------------------------------------
        // DISPOSE PHOTO MODULE
        // --------------------------------------------------------

        try
        {
            if (photoModule is not null)
            {
                await photoModule.InvokeVoidAsync(
                    "clearPreview",
                    "photoInput");
                await photoModule.DisposeAsync();
            }
        }
        catch
        {
        }


        // --------------------------------------------------------
        // DISPOSE PUSH MODULE
        // --------------------------------------------------------

        try
        {
            if (pushModule is not null)
            {
                await pushModule.DisposeAsync();
            }
        }
        catch
        {
        }


        // --------------------------------------------------------
        // DISPOSE SIGNALR
        // --------------------------------------------------------

        try
        {
            if (hub is not null)
            {
                await hub.DisposeAsync();
            }
        }
        catch
        {
        }
    }


