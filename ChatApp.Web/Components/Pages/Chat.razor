    // ============================================================

    private async Task StopTypingLaterAsync(
        CancellationToken token)
    {
        try
        {
            await Task.Delay(
                900,
                token);


            if (token.IsCancellationRequested ||
                hub is null ||
                !connected)
            {
                return;
            }


            try
            {
                await hub.InvokeAsync(
                    "UserTyping",
                    RoomCode,
                    name,
                    false);
            }
            catch
            {
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
    }


    // ============================================================
    // SEND
    // ============================================================

    private async Task Send()
    {
        if (hub is null ||
            !connected)
        {
            return;
        }


        if (string.IsNullOrWhiteSpace(draft))
        {
            return;
        }


        var text =
            draft.Trim();


        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }


        if (text.Length > 2000)
        {
            text =
                text[..2000];
        }


        var replyId =
            replyingTo?.Id;


        draft =
            string.Empty;


        try
        {
            await hub.InvokeAsync(
                "SendMessage",
                RoomCode,
                name,
                text,
                replyId);


            typingUser =
                null;


            typingCts?.Cancel();


            replyingTo =
                null;


            await InvokeAsync(
                StateHasChanged);


            await ScrollToBottomAsync();
        }
        catch (Exception ex)
        {
            draft =
                text;


            error =
                $"Unable to send message: {ex.Message}";


            await InvokeAsync(
                StateHasChanged);
        }
    }


