    // ============================================================
    // KEYBOARD / TYPING
    // ============================================================

    private async Task HandleKeyDown(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter" &&
            !e.ShiftKey)
        {
            await Send();

            return;
        }


        if (hub is null ||
            !connected)
        {
            return;
        }


        try
        {
            await hub.InvokeAsync(
                "UserTyping",
                RoomCode,
                name,
                true);
        }
        catch
        {
        }


        typingCts?.Cancel();

        typingCts?.Dispose();


        typingCts =
            new CancellationTokenSource();


        _ =
            StopTypingLaterAsync(
                typingCts.Token);
    }


