    private string GetReplyPreview(
        string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        var cleanText =
            text
                .Replace("\r", " ")
                .Replace("\n", " ")
                .Trim();

        if (cleanText.Length <= 90)
        {
            return cleanText;
        }

        return cleanText[..90] + "…";
    }


