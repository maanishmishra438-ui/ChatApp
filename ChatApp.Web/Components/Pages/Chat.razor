    // ============================================================
    // CONFIRM DELETE
    // ============================================================

    private async Task ConfirmDelete()
    {
        if (selectedMessage is null ||
            hub is null ||
            !connected)
        {
            return;
        }


        isDeleting =
            true;


        var messageId =
            selectedMessage.Id;


        try
        {
            if (deleteMode ==
                DeleteMode.DeleteForMe)
            {
                await hub.InvokeAsync(
                    "DeleteMessageForMe",
                    RoomCode,
                    messageId,
                    name);


                showDeleteModal =
                    false;


                selectedMessage =
                    null;
            }
            else
            {
                await hub.InvokeAsync(
                    "UnsendMessage",
                    RoomCode,
                    messageId,
                    name);


                showDeleteModal =
                    false;


                selectedMessage =
                    null;
            }


            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            error =
                $"Unable to delete message: {ex.Message}";


            showDeleteModal =
                false;


            selectedMessage =
                null;


            await InvokeAsync(
                StateHasChanged);
        }
        finally
        {
            isDeleting =
                false;
        }
    }


