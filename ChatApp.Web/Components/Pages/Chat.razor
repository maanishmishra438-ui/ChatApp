    private async Task OpenViewOncePhoto(MessageVm message)
    {
        if (message is null)
        {
            photoError = "This photo is not available.";
            return;
        }

        if (message.Id <= 0)
        {
            photoError = "Invalid View Once photo message.";
            return;
        }

        if (message.ViewedAt.HasValue)
        {
            photoError = "This view-once photo has already been opened.";
            return;
        }

        if (string.IsNullOrWhiteSpace(RoomCode))
        {
            photoError = "Invalid chat room.";
            return;
        }

        if (string.IsNullOrWhiteSpace(name))
        {
            photoError = "Your display name is required.";
            return;
        }

        try
        {
            photoError = null;

            var response = await JS.InvokeAsync<string>(
                "fetchViewOncePhoto",
                message.Id,
                RoomCode,
                name);

            if (string.IsNullOrWhiteSpace(response))
            {
                photoError = "This photo is no longer available.";
                return;
            }

            var viewedMessage =
                message with { ViewedAt = DateTime.UtcNow };

            var index = messages.FindIndex(x => x.Id == message.Id);
            if (index >= 0)
            {
                messages[index] = viewedMessage;
            }

            photoViewerMessage = viewedMessage;
            photoViewerUrl = response;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            photoError = $"Unable to open photo: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ClosePhotoViewer()
    {
        photoViewerMessage = null;
        photoViewerUrl = null;
        await InvokeAsync(StateHasChanged);
    }

    private static string FormatFileSize(long size)
    {
        if (size < 1024)
        {
            return $"{size} B";
        }

        if (size < 1024 * 1024)
        {
            return $"{size / 1024d:0.#} KB";
        }

        return $"{size / (1024d * 1024d):0.#} MB";
    }


    // ============================================================
    // SEND
    // ============================================================

    private async Task Send()
    {
        if (hub is null ||
            !connected)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(draft))
        {
            return;
        }

        var text =
            draft.Trim();

        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        if (text.Length > 2000)
        {
            text =
                text[..2000];
        }

        composerEmojiPickerOpen = false;
        mobileComposerEmojiOpen = false;

        var replyId =
            replyingTo?.Id;

        // Clear the composer immediately so the UI feels responsive
        // even when the SignalR round-trip takes a moment.
        draft = string.Empty;

        await InvokeAsync(StateHasChanged);

        try
        {
            await hub.InvokeAsync(
                "SendMessage",
                RoomCode,
                name,
                text,
                replyId);

            typingUser = null;

            typingCts?.Cancel();

            replyingTo = null;

            await BlurMobileComposerAsync();

            await InvokeAsync(
                StateHasChanged);

            await ScrollToBottomAsync();
        }
        catch (Exception ex)
        {
            draft = text;

            error =
                $"Unable to send message: {ex.Message}";

            await InvokeAsync(
                StateHasChanged);
        }
    }


