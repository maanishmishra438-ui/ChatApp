    // ============================================================
    // INITIALIZE CHAT
    // ============================================================

    private async Task InitializeChatAsync()
    {
        if (hub is not null)
        {
            return;
        }

        var history =
            await ChatService.GetMessagesAsync(
                RoomCode,
                name);

        messages.Clear();

        foreach (var item in history)
        {
            messages.Add(
                new MessageVm(
                    item.Id,
                    item.Sender,
                    item.Text,
                    item.SentAt,
                    item.IsRead,
                    item.IsRead,
                    item.ReplyToMessageId,
                    item.ReplyToSender,
                    item.ReplyToText,
                    item.IsDeleted,
                    null,
                    item.MessageType,
                    item.MediaPath,
                    item.MediaContentType,
                    item.MediaFileName,
                    item.MediaSize,
                    item.PhotoMode,
                    item.ExpiresAt,
                    item.ViewedAt));
        }


        // --------------------------------------------------------
        // PARTICIPANTS
        // --------------------------------------------------------

        knownParticipants.Add(name);

        foreach (var message in messages)
        {
            if (!string.IsNullOrWhiteSpace(
                    message.Sender))
            {
                knownParticipants.Add(
                    message.Sender);
            }
        }


        // --------------------------------------------------------
        // REACTIONS
        // --------------------------------------------------------

        var reactionMap =
            await ChatService.GetReactionsAsync(
                messages.Select(x => x.Id));

        for (var i = 0;
             i < messages.Count;
             i++)
        {
            var message =
                messages[i];

            if (reactionMap.TryGetValue(
                    message.Id,
                    out var reactionList))
            {
                messages[i] =
                    message with
                    {
                        Reactions =
                            reactionList
                                .Select(
                                    x =>
                                        new ReactionVm(
                                            x.UserName,
                                            x.Reaction))
                                .ToList()
                    };
            }
        }


        // --------------------------------------------------------
        // SIGNALR HUB
        // --------------------------------------------------------

        hub =
            new HubConnectionBuilder()
                .WithUrl(
                    Navigation.ToAbsoluteUri(
                        "/chathub"),
                    options =>
                    {
#if DEBUG
                        // Local development uses the ASP.NET Core
                        // development HTTPS certificate. The browser
                        // trusts it, but the server-side SignalR client
                        // may not. Keep this bypass DEBUG-only.
                        options.HttpMessageHandlerFactory =
                            innerHandler =>
                            {
                                if (innerHandler is HttpClientHandler httpClientHandler)
                                {
                                    httpClientHandler.ServerCertificateCustomValidationCallback =
                                        HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
                                }

                                return innerHandler;
                            };

                        options.WebSocketConfiguration =
                            webSocketOptions =>
                            {
                                webSocketOptions.RemoteCertificateValidationCallback =
                                    (_, _, _, _) => true;
                            };
#endif
                    })
                .WithAutomaticReconnect()
                .Build();


        // --------------------------------------------------------
        // RECEIVE MESSAGE
        // --------------------------------------------------------

        hub.On<MessageVm>(
            "ReceiveMessage",
            async message =>
            {
                await InvokeAsync(() =>
                {
                    if (messages.All(
                            x => x.Id != message.Id))
                    {
                        messages.Add(
                            message with
                            {
                                Reactions =
                                    message.Reactions ??
                                    new List<ReactionVm>()
                            });
                    }

                    if (!string.IsNullOrWhiteSpace(
                            message.Sender))
                    {
                        knownParticipants.Add(
                            message.Sender);
                    }

                    StateHasChanged();
                });

                if (!string.Equals(
                        message.Sender,
                        name,
                        StringComparison.OrdinalIgnoreCase) &&
                    hub is not null &&
                    connected)
                {
                    try
                    {
                        await hub.InvokeAsync(
                            "ConfirmMessageDelivered",
                            RoomCode,
                            message.Id,
                            name);
                    }
                    catch
                    {
                    }
                }

                await ScrollToBottomAsync();
            });


        // --------------------------------------------------------
        // DELIVERED
        // --------------------------------------------------------

        hub.On<long>(
            "MessageDelivered",
            async messageId =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        var message =
                            messages[index];

                        if (message.Sender.Equals(
                                name,
                                StringComparison.OrdinalIgnoreCase))
                        {
                            messages[index] =
                                message with
                                {
                                    IsDelivered = true
                                };
                        }
                    }

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // PRESENCE SNAPSHOT
        // --------------------------------------------------------

        hub.On<List<string>>(
            "RoomPresenceSnapshot",
            async users =>
            {
                await InvokeAsync(() =>
                {
                    // ------------------------------------------------
                    // Build a clean snapshot of currently online users.
                    // ------------------------------------------------

                    var snapshotUsers =
                        new HashSet<string>(
                            StringComparer.OrdinalIgnoreCase);

                    foreach (var user in users)
                    {
                        if (string.IsNullOrWhiteSpace(user))
                        {
                            continue;
                        }

                        var normalizedUser =
                            user.Trim();

                        snapshotUsers.Add(
                            normalizedUser);

                        // User is online.
                        onlineUsers.Add(
                            normalizedUser);

                        // Keep user in room member list.
                        knownParticipants.Add(
                            normalizedUser);

                        // Cancel any pending removal.
                        CancelOfflineRemoval(
                            normalizedUser);
                    }


                    // ------------------------------------------------
                    // Users missing from the latest snapshot are no
                    // longer online.
                    // ------------------------------------------------

                    foreach (
                        var previousOnlineUser
                        in onlineUsers.ToList())
                    {
                        if (!snapshotUsers.Contains(
                                previousOnlineUser))
                        {
                            onlineUsers.Remove(
                                previousOnlineUser);

                            ScheduleOfflineRemoval(
                                previousOnlineUser);
                        }
                    }


                    // ------------------------------------------------
                    // Current user should stay online while the
                    // SignalR connection is active.
                    // ------------------------------------------------

                    if (!string.IsNullOrWhiteSpace(name))
                    {
                        knownParticipants.Add(name);

                        if (connected)
                        {
                            onlineUsers.Add(name);

                            CancelOfflineRemoval(
                                name);
                        }
                    }

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // PRESENCE CHANGE
        // --------------------------------------------------------

        hub.On<string, bool>(
            "UserPresenceChanged",
            async (userName, isOnline) =>
            {
                await InvokeAsync(() =>
                {
                    if (string.IsNullOrWhiteSpace(
                            userName))
                    {
                        return;
                    }

                    var normalizedUserName =
                        userName.Trim();

                    // Always keep participant known.
                    knownParticipants.Add(
                        normalizedUserName);

                    if (isOnline)
                    {
                        // --------------------------------------------
                        // USER ONLINE
                        // --------------------------------------------

                        onlineUsers.Add(
                            normalizedUserName);

                        CancelOfflineRemoval(
                            normalizedUserName);
                    }
                    else
                    {
                        // --------------------------------------------
                        // USER OFFLINE
                        // --------------------------------------------

                        onlineUsers.Remove(
                            normalizedUserName);

                        ScheduleOfflineRemoval(
                            normalizedUserName);
                    }

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // REACTION CHANGE
        // --------------------------------------------------------

        hub.On<long, List<ReactionVm>>(
            "MessageReactionChanged",
            async (messageId, reactions) =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        var message =
                            messages[index];

                        messages[index] =
                            message with
                            {
                                Reactions =
                                    reactions ??
                                    new List<ReactionVm>()
                            };
                    }

                    reactionPickerMessageId = null;

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // READ
        // --------------------------------------------------------

        hub.On<long>(
            "MessageRead",
            async messageId =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        var message =
                            messages[index];

                        messages[index] =
                            message with
                            {
                                IsRead = true,
                                IsDelivered = true
                            };

                        seenTimes[messageId] =
                            DateTime.UtcNow;
                    }

                    StartSeenTimer();

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // TYPING
        // --------------------------------------------------------

        hub.On<string, bool>(
            "UserTyping",
            async (sender, isTyping) =>
            {
                await InvokeAsync(() =>
                {
                    if (string.Equals(
                            sender,
                            name,
                            StringComparison.OrdinalIgnoreCase))
                    {
                        return;
                    }

                    typingUser =
                        isTyping
                            ? sender
                            : null;

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // DELETE FOR ME
        // --------------------------------------------------------

        hub.On<long>(
            "MessageDeletedForMe",
            async messageId =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        messages.RemoveAt(index);
                    }

                    openMenuMessageId = null;
                    reactionPickerMessageId = null;

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // UNSEND
        // --------------------------------------------------------

        hub.On<long>(
            "MessageUnsent",
            async messageId =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        var message =
                            messages[index];

                        messages[index] =
                            message with
                            {
                                Text =
                                    "[This message was deleted]",

                                ReplyToMessageId = null,
                                ReplyToSender = null,
                                ReplyToText = null,
                                IsDeleted = true,

                                Reactions =
                                    new List<ReactionVm>()
                            };
                    }

                    openMenuMessageId = null;
                    reactionPickerMessageId = null;

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // RECONNECTING
        // --------------------------------------------------------

        hub.Reconnecting += _ =>
        {
            // SignalR is temporarily disconnected.
            connected = false;

            // Current user should immediately show Offline.
            if (!string.IsNullOrWhiteSpace(name))
            {
                onlineUsers.Remove(name);
            }

            return InvokeAsync(
                StateHasChanged);
        };


        // --------------------------------------------------------
        // RECONNECTED
        // --------------------------------------------------------

        hub.Reconnected += async _ =>
        {
            if (hub is null ||
                string.IsNullOrWhiteSpace(RoomCode) ||
                string.IsNullOrWhiteSpace(name))
            {
                return;
            }

            Exception? lastException = null;

            // The SignalR transport can reconnect before the server-side
            // room membership is ready again. Retry JoinRoom a few times
            // instead of immediately marking the user as failed.
            for (var attempt = 1; attempt <= 3; attempt++)
            {
                try
                {
                    await hub.InvokeAsync(
                        "JoinRoom",
                        RoomCode,
                        name);

                    connected = true;

                    knownParticipants.Add(name);
                    onlineUsers.Add(name);

                    CancelOfflineRemoval(name);

                    error = null;

                    await InvokeAsync(
                        StateHasChanged);

                    return;
                }
                catch (Exception ex)
                {
                    lastException = ex;

                    if (attempt < 3)
                    {
                        try
                        {
                            await Task.Delay(
                                TimeSpan.FromSeconds(attempt),
                                presenceHeartbeatCts?.Token ??
                                CancellationToken.None);
                        }
                        catch (OperationCanceledException)
                        {
                            break;
                        }
                    }
                }
            }

            connected = false;
            onlineUsers.Remove(name);

            // Do not silently hide the actual JoinRoom failure.
            error =
                lastException is null
                    ? "Chat reconnected, but room rejoin failed."
                    : $"Chat reconnected, but room rejoin failed: {lastException.Message}";

            Console.WriteLine(
                $"[ChatApp] SignalR RejoinRoom failed after reconnect: {lastException}");

            await InvokeAsync(
                StateHasChanged);
        };


        // --------------------------------------------------------
        // CLOSED
        // --------------------------------------------------------

        hub.Closed += _ =>
        {
            connected = false;

            if (!string.IsNullOrWhiteSpace(name))
            {
                onlineUsers.Remove(name);

                CancelOfflineRemoval(name);
            }

            return InvokeAsync(
                StateHasChanged);
        };


        // --------------------------------------------------------
        // START
        // --------------------------------------------------------

        try
        {
            await hub.StartAsync();
        }
        catch (Exception ex)
        {
            connected = false;
            error =
                $"Unable to connect to chat server: {ex.Message}";

            Console.WriteLine(
                $"[ChatApp] SignalR StartAsync failed: {ex}");

            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            await hub.InvokeAsync(
                "JoinRoom",
                RoomCode,
                name);
        }
        catch (Exception ex)
        {
            connected = false;
            error =
                $"Unable to join chat room: {ex.Message}";

            Console.WriteLine(
                $"[ChatApp] SignalR JoinRoom failed: {ex}");

            await InvokeAsync(StateHasChanged);
            return;
        }

        connected = true;

        // Current user is definitely online after successful join.
        knownParticipants.Add(name);
        onlineUsers.Add(name);

        CancelOfflineRemoval(name);

        StartSeenTimer();

        // Start heartbeat AFTER successful JoinRoom.
        StartPresenceHeartbeat();

        await InvokeAsync(
            StateHasChanged);

        await ScrollToBottomAsync();
    }


    // ============================================================
    // PRESENCE HEARTBEAT
    // ============================================================

    private void StartPresenceHeartbeat()
    {
        if (presenceHeartbeatTimer is not null)
        {
            return;
        }

        presenceHeartbeatCts =
            new CancellationTokenSource();

        presenceHeartbeatTimer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(10));

        _ =
            RunPresenceHeartbeatAsync(
                presenceHeartbeatCts.Token);
    }


    private async Task RunPresenceHeartbeatAsync(
        CancellationToken token)
    {
        try
        {
            while (
                presenceHeartbeatTimer is not null &&
                await presenceHeartbeatTimer.WaitForNextTickAsync(
                    token))
            {
                if (hub is null ||
                    !connected)
                {
                    continue;
                }

                try
                {
                    await hub.InvokeAsync(
                        "PresenceHeartbeat");
                }
                catch
                {
                    // SignalR may currently be reconnecting.
                    // Keep heartbeat loop alive.
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
    }


