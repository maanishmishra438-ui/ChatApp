    // ============================================================
    // INITIALIZE CHAT
    // ============================================================

    private async Task InitializeChatAsync()
    {
        if (hub is not null)
        {
            return;
        }

        var history =
            await ChatService.GetMessagesAsync(
                RoomCode,
                name);

        messages.Clear();

        foreach (var item in history)
        {
            messages.Add(
                new MessageVm(
                    item.Id,
                    item.Sender,
                    item.Text,
                    item.SentAt,
                    item.IsRead,
                    item.IsRead,
                    item.ReplyToMessageId,
                    item.ReplyToSender,
                    item.ReplyToText,
                    item.IsDeleted));
        }


        // --------------------------------------------------------
        // PARTICIPANTS
        // --------------------------------------------------------

        knownParticipants.Add(name);

        foreach (var message in messages)
        {
            if (!string.IsNullOrWhiteSpace(
                    message.Sender))
            {
                knownParticipants.Add(
                    message.Sender);
            }
        }


        // --------------------------------------------------------
        // REACTIONS
        // --------------------------------------------------------

        var reactionMap =
            await ChatService.GetReactionsAsync(
                messages.Select(x => x.Id));

        for (var i = 0;
             i < messages.Count;
             i++)
        {
            var message =
                messages[i];

            if (reactionMap.TryGetValue(
                    message.Id,
                    out var reactionList))
            {
                messages[i] =
                    message with
                    {
                        Reactions =
                            reactionList
                                .Select(
                                    x =>
                                        new ReactionVm(
                                            x.UserName,
                                            x.Reaction))
                                .ToList()
                    };
            }
        }


        // --------------------------------------------------------
        // SIGNALR HUB
        // --------------------------------------------------------

        hub =
            new HubConnectionBuilder()
                .WithUrl(
                    Navigation.ToAbsoluteUri(
                        "/chathub"))
                .WithAutomaticReconnect()
                .Build();


        // --------------------------------------------------------
        // RECEIVE MESSAGE
        // --------------------------------------------------------

        hub.On<MessageVm>(
            "ReceiveMessage",
            async message =>
            {
                await InvokeAsync(() =>
                {
                    if (messages.All(
                            x => x.Id != message.Id))
                    {
                        messages.Add(
                            message with
                            {
                                Reactions =
                                    message.Reactions ??
                                    new List<ReactionVm>()
                            });
                    }

                    if (!string.IsNullOrWhiteSpace(
                            message.Sender))
                    {
                        knownParticipants.Add(
                            message.Sender);
                    }

                    StateHasChanged();
                });

                if (!string.Equals(
                        message.Sender,
                        name,
                        StringComparison.OrdinalIgnoreCase) &&
                    hub is not null &&
                    connected)
                {
                    try
                    {
                        await hub.InvokeAsync(
                            "ConfirmMessageDelivered",
                            RoomCode,
                            message.Id,
                            name);
                    }
                    catch
                    {
                    }
                }

                await ScrollToBottomAsync();
            });


        // --------------------------------------------------------
        // DELIVERED
        // --------------------------------------------------------

        hub.On<long>(
            "MessageDelivered",
            async messageId =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        var message =
                            messages[index];

                        if (message.Sender.Equals(
                                name,
                                StringComparison.OrdinalIgnoreCase))
                        {
                            messages[index] =
                                message with
                                {
                                    IsDelivered = true
                                };
                        }
                    }

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // PRESENCE SNAPSHOT
        // --------------------------------------------------------

        hub.On<List<string>>(
            "RoomPresenceSnapshot",
            async users =>
            {
                await InvokeAsync(() =>
                {
                    // ------------------------------------------------
                    // Build a clean snapshot of currently online users.
                    // ------------------------------------------------

                    var snapshotUsers =
                        new HashSet<string>(
                            StringComparer.OrdinalIgnoreCase);

                    foreach (var user in users)
                    {
                        if (string.IsNullOrWhiteSpace(user))
                        {
                            continue;
                        }

                        var normalizedUser =
                            user.Trim();

                        snapshotUsers.Add(
                            normalizedUser);

                        // User is online.
                        onlineUsers.Add(
                            normalizedUser);

                        // Keep user in room member list.
                        knownParticipants.Add(
                            normalizedUser);

                        // Cancel any pending removal.
                        CancelOfflineRemoval(
                            normalizedUser);
                    }


                    // ------------------------------------------------
                    // Users missing from the latest snapshot are no
                    // longer online.
                    // ------------------------------------------------

                    foreach (
                        var previousOnlineUser
                        in onlineUsers.ToList())
                    {
                        if (!snapshotUsers.Contains(
                                previousOnlineUser))
                        {
                            onlineUsers.Remove(
                                previousOnlineUser);

                            ScheduleOfflineRemoval(
                                previousOnlineUser);
                        }
                    }


                    // ------------------------------------------------
                    // Current user should stay online while the
                    // SignalR connection is active.
                    // ------------------------------------------------

                    if (!string.IsNullOrWhiteSpace(name))
                    {
                        knownParticipants.Add(name);

                        if (connected)
                        {
                            onlineUsers.Add(name);

                            CancelOfflineRemoval(
                                name);
                        }
                    }

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // PRESENCE CHANGE
        // --------------------------------------------------------

        hub.On<string, bool>(
            "UserPresenceChanged",
            async (userName, isOnline) =>
            {
                await InvokeAsync(() =>
                {
                    if (string.IsNullOrWhiteSpace(
                            userName))
                    {
                        return;
                    }

                    var normalizedUserName =
                        userName.Trim();

                    // Always keep participant known.
                    knownParticipants.Add(
                        normalizedUserName);

                    if (isOnline)
                    {
                        // --------------------------------------------
                        // USER ONLINE
                        // --------------------------------------------

                        onlineUsers.Add(
                            normalizedUserName);

                        CancelOfflineRemoval(
                            normalizedUserName);
                    }
                    else
                    {
                        // --------------------------------------------
                        // USER OFFLINE
                        // --------------------------------------------

                        onlineUsers.Remove(
                            normalizedUserName);

                        ScheduleOfflineRemoval(
                            normalizedUserName);
                    }

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // REACTION CHANGE
        // --------------------------------------------------------

        hub.On<long, List<ReactionVm>>(
            "MessageReactionChanged",
            async (messageId, reactions) =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        var message =
                            messages[index];

                        messages[index] =
                            message with
                            {
                                Reactions =
                                    reactions ??
                                    new List<ReactionVm>()
                            };
                    }

                    reactionPickerMessageId = null;

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // READ
        // --------------------------------------------------------

        hub.On<long>(
            "MessageRead",
            async messageId =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        var message =
                            messages[index];

                        messages[index] =
                            message with
                            {
                                IsRead = true,
                                IsDelivered = true
                            };

                        seenTimes[messageId] =
                            DateTime.UtcNow;
                    }

                    StartSeenTimer();

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // TYPING
        // --------------------------------------------------------

        hub.On<string, bool>(
            "UserTyping",
            async (sender, isTyping) =>
            {
                await InvokeAsync(() =>
                {
                    if (string.Equals(
                            sender,
                            name,
                            StringComparison.OrdinalIgnoreCase))
                    {
                        return;
                    }

                    typingUser =
                        isTyping
                            ? sender
                            : null;

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // DELETE FOR ME
        // --------------------------------------------------------

        hub.On<long>(
            "MessageDeletedForMe",
            async messageId =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        messages.RemoveAt(index);
                    }

                    openMenuMessageId = null;
                    reactionPickerMessageId = null;

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // UNSEND
        // --------------------------------------------------------

        hub.On<long>(
            "MessageUnsent",
            async messageId =>
            {
                await InvokeAsync(() =>
                {
                    var index =
                        messages.FindIndex(
                            x => x.Id == messageId);

                    if (index >= 0)
                    {
                        var message =
                            messages[index];

                        messages[index] =
                            message with
                            {
                                Text =
                                    "[This message was deleted]",

                                ReplyToMessageId = null,
                                ReplyToSender = null,
                                ReplyToText = null,
                                IsDeleted = true,

                                Reactions =
                                    new List<ReactionVm>()
                            };
                    }

                    openMenuMessageId = null;
                    reactionPickerMessageId = null;

                    StateHasChanged();
                });
            });


        // --------------------------------------------------------
        // RECONNECTING
        // --------------------------------------------------------

        hub.Reconnecting += _ =>
        {
            // SignalR is temporarily disconnected.
            connected = false;

            // Current user should immediately show Offline.
            if (!string.IsNullOrWhiteSpace(name))
            {
                onlineUsers.Remove(name);
            }

            return InvokeAsync(
                StateHasChanged);
        };


        // --------------------------------------------------------
        // RECONNECTED
        // --------------------------------------------------------

        hub.Reconnected += async _ =>
        {
            if (hub is null)
            {
                return;
            }

            try
            {
                // Join the room again after reconnect.
                await hub.InvokeAsync(
                    "JoinRoom",
                    RoomCode,
                    name);

                connected = true;

                // Current user is online again.
                knownParticipants.Add(name);

                onlineUsers.Add(name);

                CancelOfflineRemoval(name);
            }
            catch
            {
                connected = false;

                onlineUsers.Remove(name);
            }

            await InvokeAsync(
                StateHasChanged);
        };


        // --------------------------------------------------------
        // CLOSED
        // --------------------------------------------------------

        hub.Closed += _ =>
        {
            connected = false;

            if (!string.IsNullOrWhiteSpace(name))
            {
                onlineUsers.Remove(name);

                CancelOfflineRemoval(name);
            }

            return InvokeAsync(
                StateHasChanged);
        };


        // --------------------------------------------------------
        // START
        // --------------------------------------------------------

        await hub.StartAsync();

        await hub.InvokeAsync(
            "JoinRoom",
            RoomCode,
            name);

        connected = true;

        // Current user is definitely online after successful join.
        knownParticipants.Add(name);
        onlineUsers.Add(name);

        CancelOfflineRemoval(name);

        StartSeenTimer();

        // Start heartbeat AFTER successful JoinRoom.
        StartPresenceHeartbeat();

        await InvokeAsync(
            StateHasChanged);

        await ScrollToBottomAsync();
    }


    // ============================================================
    // PRESENCE HEARTBEAT
    // ============================================================

    private void StartPresenceHeartbeat()
    {
        if (presenceHeartbeatTimer is not null)
        {
            return;
        }

        presenceHeartbeatCts =
            new CancellationTokenSource();

        presenceHeartbeatTimer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(10));

        _ =
            RunPresenceHeartbeatAsync(
                presenceHeartbeatCts.Token);
    }


    private async Task RunPresenceHeartbeatAsync(
        CancellationToken token)
    {
        try
        {
            while (
                presenceHeartbeatTimer is not null &&
                await presenceHeartbeatTimer.WaitForNextTickAsync(
                    token))
            {
                if (hub is null ||
                    !connected)
                {
                    continue;
                }

                try
                {
                    await hub.InvokeAsync(
                        "PresenceHeartbeat");
                }
                catch
                {
                    // SignalR may currently be reconnecting.
                    // Keep heartbeat loop alive.
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
    }


    // ============================================================
    // ENABLE NOTIFICATIONS
    // ============================================================

    private async Task EnableNotifications()
    {
        if (string.IsNullOrWhiteSpace(name) ||
            string.IsNullOrWhiteSpace(RoomCode))
        {
            return;
        }

        notificationBusy = true;
        notificationError = null;

        try
        {
            if (pushModule is null)
            {
                pushModule =
                    await JS.InvokeAsync<IJSObjectReference>(
                        "import",
                        "/js/pushNotifications.js");
            }

            var success =
                await pushModule.InvokeAsync<bool>(
                    "enable",
                    name,
                    RoomCode);

            notificationsEnabled =
                success;

            if (success)
            {
                toastMessage =
                    "Notifications enabled 🔔";

                showToast = true;

                _ =
                    HideToastLaterAsync();
            }
            else
            {
                notificationError =
                    "Notification permission was not granted.";
            }
        }
        catch (JSException ex)
        {
            notificationError =
                $"Notification setup failed: {ex.Message}";
        }
        catch (Exception ex)
        {
            notificationError =
                $"Unable to enable notifications: {ex.Message}";
        }
        finally
        {
            notificationBusy = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }


